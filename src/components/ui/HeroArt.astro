---
// Shared product composition for first screens: transparent PNG, fitted whole on every viewport.
import Pic from '@/components/ui/Pic.astro';
import { resolvePic } from '@/lib/pic';
interface Props {
  name: string;
  w: number;
  h: number;
  mobileName: string;
  mw: number;
  mh: number;
  alt: string;
  label?: string;
  class?: string;
}
const { name, w, h, mobileName, mw, mh, alt, label, class: cls } = Astro.props;
const mobile = resolvePic(mobileName);
---
<div class:list={['hero-art', cls]}>
  <picture class="art-pic">
    {'src' in mobile && <source media="(max-width: 900px)" srcset={mobile.src} width={mw} height={mh} />}
    <Pic name={name} alt={alt} w={w} h={h} fit="contain" loading="eager" fetchpriority="high" label={label} class="art-img" />
  </picture>
</div>
<style>
  .hero-art { position: relative; width: 100%; aspect-ratio: 6 / 5; }
  .art-pic { position: absolute; inset: 0; }
  .art-pic :global(.art-img) { width: 100%; height: 100%; object-position: 50% 50%; }
  .art-pic :global(.pic-ph) { aspect-ratio: auto !important; border-radius: var(--radius-panel); }
  @media (max-width: 900px) {
    .hero-art { max-width: 620px; margin-inline: auto; }
  }
</style>
