---
// «Наши работы»: heading with the peeking cat over the strip, a strip of real work photos that scrolls by itself
// (finger, wheel, keyboard) and, with JS, round arrow buttons at the sides and page dots (works-slider.ts).
import SectionHead from '@/components/ui/SectionHead.astro';
import Button from '@/components/ui/Button.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Pic from '@/components/ui/Pic.astro';
import { homeWorks, workLabel } from '@/data/home';
import type { PortfolioItem } from '@/data/types';
import { resolvePic } from '@/lib/pic';

const labelIcon: Record<string, IconName> = {
  Футболки: 'shirt',
  Худи: 'shirt',
  Спорт: 'award',
  Шопперы: 'shopping-bag',
  Бейсболки: 'shirt',
  Кружки: 'coffee',
  Значки: 'badge',
  Брелоки: 'badge',
  Магниты: 'image',
  Стикеры: 'sticker',
  Полиграфия: 'file-text',
  Календари: 'calendar',
  'Для компаний': 'building',
  Подарки: 'gift',
  Свадьба: 'gift',
};
interface Props {
  /** the works of the strip; the home page shows the mixed selection */
  works?: PortfolioItem[];
  eyebrow?: string;
  title?: string;
  accent?: string;
  lead?: string;
}
const { works = homeWorks, eyebrow = 'Портфолио', title = 'Наши', accent = 'работы', lead = 'Настоящие заказы наших клиентов' } = Astro.props;
// the owner's cat picture has not arrived yet: then a compact placeholder that never covers the cards
const catReady = 'src' in resolvePic('cat-peek');
---

<section class="section works" aria-labelledby="works-title" data-works>
  <div class="wrap">
    <div class="wk-head">
      <SectionHead id="works-title" eyebrow={eyebrow} title={title} accent={accent} lead={lead}>
        <div slot="action" class="wk-action">
          <div class:list={['wk-cat', { 'wk-cat-ph': !catReady }]}>
            <Pic name="cat-peek" alt="" w={1400} h={900} fit="contain" label="cat-peek" />
          </div>
          <Button href="/portfolio" variant="ghost" arrow>Смотреть всё портфолио</Button>
        </div>
      </SectionHead>
    </div>

    <div class="wk-stage">
      <ul class="wk-track" role="list" tabindex="0" aria-label="Работы мастерской, лента листается" data-works-track>
        {
          works.map((w) => {
            const label = workLabel(w.tags);
            return (
              <li class="wk-item">
                <figure class="wk-card">
                  <img src={w.src} alt={w.title} width="400" height="500" loading="lazy" decoding="async" />
                  <figcaption class="wk-label">
                    <Icon name={labelIcon[label] ?? 'image'} size={18} />
                    {label}
                  </figcaption>
                </figure>
              </li>
            );
          })
        }
      </ul>
      <button class="wk-arrow wk-prev" type="button" aria-label="Предыдущие работы" data-works-prev hidden>
        <Icon name="chevron-left" size={24} />
      </button>
      <button class="wk-arrow wk-next" type="button" aria-label="Следующие работы" data-works-next hidden>
        <Icon name="chevron-right" size={24} />
      </button>
    </div>
    <div class="wk-dots" data-works-dots hidden></div>
  </div>
</section>

<script>
  import { initWorksSlider } from '@/scripts/works-slider';
  import { initWorksCat } from '@/scripts/works-cat';
  document.querySelectorAll<HTMLElement>('[data-works]').forEach((root) => {
    initWorksSlider(root);
    initWorksCat(root);
  });
</script>

<style>
  .wk-head {
    position: relative;
  }
  .wk-head :global(.sh) {
    position: relative;
    z-index: 1;
  }
  /* the cat sits between the heading and the button, above the cards with air between, tilted 10deg */
  /* Card tops are the heading's margin (--s-6) plus the strip's top padding (--s-2) below the heading block
     (the action box ends level with the heading block). The cat is anchored to the button's own box,
     so it stands just left of «Смотреть всё портфолио» whatever the button's width. */
  .wk-action {
    position: relative;
  }
  .wk-cat {
    --cw: clamp(210px, 24vw, 340px);
    position: absolute;
    z-index: 2;
    right: calc(100% + var(--s-4));
    /* lifted off the cards: the picture's blank bottom strip, the card offset, the tilt (the low corner drops
       about cw * 0.087) and 24px of air between the hoodie edge and the cards */
    bottom: calc(-1 * (var(--s-6) + var(--s-2)) - var(--cw) * 58 / 1399 + var(--cw) * 0.09 + 28px);
    width: var(--cw);
    transform: rotate(-10deg);
    transform-origin: 50% 100%;
    pointer-events: none;
  }
  /* the picture's flat bottom cut (the hoodie hem) melts into the background instead of standing on a white
     ledge (owner, 16.11.2026: «под котом белая полоса не очень выглядит»); the fade turns together with the cat */
  .wk-cat:not(.wk-cat-ph) {
    -webkit-mask-image: linear-gradient(0deg, transparent 0, transparent 4%, #000 22%);
    mask-image: linear-gradient(0deg, transparent 0, transparent 4%, #000 22%);
  }
  /* The cat peeks out once, when the block first comes into view (works-cat.ts): the cat fades in,
     the cat rises 12px and sways ±3° around its bottom edge, then stays still.
     Without JS (or with reduced motion) the script never sets data-cat and the cat simply sits in place. */
  .wk-cat[data-cat='wait'] {
    opacity: 0;
  }
  .wk-cat[data-cat='wait'] :global(img) {
    transform: translateY(12px);
  }
  .wk-cat[data-cat='peek'] {
    animation: wk-cat-in 200ms var(--ease-out) both;
  }
  .wk-cat[data-cat='peek'] :global(img) {
    transform-origin: 50% 100%;
    animation: wk-cat-peek 500ms var(--ease-out) both;
  }
  @keyframes wk-cat-in {
    from {
      opacity: 0;
    }
  }
  @keyframes wk-cat-peek {
    0% {
      transform: translateY(12px) rotate(-3deg);
    }
    55% {
      transform: translateY(0) rotate(3deg);
    }
    100% {
      transform: none;
    }
  }
  .wk-cat-ph {
    bottom: 0;
    width: clamp(150px, 15vw, 210px);
    opacity: 0.7;
  }
  .wk-cat-ph :global(.pic-ph) {
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    border-bottom: 0;
  }

  .wk-stage {
    position: relative;
  }
  .wk-track {
    --per: 4;
    display: flex;
    gap: var(--s-4);
    margin: 0;
    padding: var(--s-2) 0 var(--s-5);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: #b9cdf2 transparent;
  }
  .wk-track:focus-visible {
    outline-offset: -3px;
    border-radius: var(--radius-card);
  }
  /* with the buttons and dots working, the bare scrollbar is not needed */
  .works:global(.is-js) .wk-track {
    scrollbar-width: none;
  }
  .works:global(.is-js) .wk-track::-webkit-scrollbar {
    display: none;
  }
  .wk-item {
    flex: 0 0 calc((100% - (var(--per) - 1) * var(--s-4)) / var(--per));
    scroll-snap-align: start;
  }
  .wk-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    background: var(--sky);
    box-shadow: var(--shadow-card);
  }
  .wk-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .wk-card:hover img {
    transform: scale(1.04);
  }
  .wk-label {
    position: absolute;
    left: var(--s-3);
    bottom: var(--s-3);
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    max-width: calc(100% - 2 * var(--s-3));
    min-height: 40px;
    padding: 6px 16px 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(11, 26, 63, 0.12);
  }
  .wk-label :global(.icon) {
    flex: none;
    color: var(--blue);
  }

  .wk-arrow {
    position: absolute;
    top: calc(50% - var(--s-2));
    z-index: 3;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--white);
    color: var(--blue);
    box-shadow: var(--shadow-pop);
    transform: translateY(-50%);
    transition:
      background-color var(--t-fast) ease,
      color var(--t-fast) ease,
      opacity var(--t-fast) ease;
  }
  .wk-arrow[hidden] {
    display: none;
  }
  .wk-arrow:hover:not([aria-disabled='true']) {
    background: var(--blue);
    color: var(--white);
  }
  /* at the end of the strip the arrow fades out, but stays focusable so the keyboard focus is not lost */
  .wk-arrow[aria-disabled='true'] {
    opacity: 0;
    pointer-events: none;
  }
  .wk-arrow[aria-disabled='true']:focus-visible {
    opacity: 0.5;
  }
  .wk-prev {
    left: -28px;
  }
  .wk-next {
    right: -28px;
  }

  .wk-dots {
    display: flex;
    justify-content: center;
    gap: var(--s-1);
    margin-top: var(--s-2);
  }
  .wk-dots[hidden] {
    display: none;
  }
  .wk-dots :global(.wk-dot) {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
  }
  .wk-dots :global(.wk-dot)::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: var(--radius-pill);
    background: #c9d8f3;
    transition:
      background-color var(--t-fast) ease,
      width var(--t) var(--ease);
  }
  .wk-dots :global(.wk-dot[aria-current='true'])::before {
    width: 28px;
    background: var(--blue);
  }
  .wk-dots :global(.wk-dot:hover)::before {
    background: var(--blue-hover);
  }

  /* reduced motion: the cat is never hidden or moved (the script does not start either) */
  @media (prefers-reduced-motion: reduce) {
    .wk-cat[data-cat] {
      opacity: 1;
      animation: none;
    }
    .wk-cat[data-cat] :global(img) {
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 1320px) {
    .wk-prev {
      left: -12px;
    }
    .wk-next {
      right: -12px;
    }
  }
  @media (max-width: 1100px) {
    .wk-track {
      --per: 3;
    }
  }
  @media (max-width: 900px) {
    .wk-cat {
      display: none;
    }
    .wk-track {
      --per: 2;
    }
    .wk-arrow {
      width: 48px;
      height: 48px;
    }
    .wk-prev {
      left: -4px;
    }
    .wk-next {
      right: -4px;
    }
  }
  @media (max-width: 560px) {
    /* one and a bit of the next card: the strip shows it scrolls */
    .wk-track {
      --per: 1.25;
      gap: var(--s-3);
    }
    .wk-item {
      flex-basis: calc((100% - var(--s-3)) / var(--per));
    }
    .wk-head :global(.btn) {
      width: 100%;
    }
    .wk-head :global(.sh-action) {
      width: 100%;
    }
  }
</style>
