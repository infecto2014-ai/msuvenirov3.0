---
// «Частые вопросы»: six questions as <details> (open without JS). FAQPage JSON-LD is added by index.astro.
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import { homeFaq } from '@/data/home';
---

<section class="section faq-sec" aria-labelledby="faq-title">
  <div class="wrap">
    <SectionHead id="faq-title" title="Частые" accent="вопросы">
      <a slot="action" class="faq-all" href="/faq">
        Все вопросы <Icon name="arrow-right" size={20} />
      </a>
    </SectionHead>
    <div class="faq">
      {
        homeFaq.map((f) => (
          <details class="faq-item">
            <summary class="faq-q">
              <span>{f.q}</span>
              <span class="faq-ic">
                <Icon name="chevron-down" size={20} />
              </span>
            </summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-all {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    transition: color var(--t-fast) ease;
  }
  .faq-all :global(.icon) {
    color: var(--blue);
    transition: transform var(--t) var(--ease);
  }
  .faq-all:hover {
    color: var(--blue-hover);
  }
  .faq-all:hover :global(.icon) {
    transform: translateX(3px);
  }
  .faq {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--s-4);
  }
  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--white);
    transition:
      border-color var(--t-fast) ease,
      box-shadow var(--t) var(--ease);
  }
  .faq-item:hover,
  .faq-item[open] {
    border-color: #c4d6f5;
    box-shadow: var(--shadow-card);
  }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 64px;
    padding: var(--s-3) var(--s-4) var(--s-3) var(--s-5);
    border-radius: var(--radius-card);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.3;
  }
  .faq-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--sky);
    color: var(--blue);
    transition:
      transform var(--t) var(--ease),
      background-color var(--t-fast) ease,
      color var(--t-fast) ease;
  }
  .faq-item[open] .faq-ic {
    transform: rotate(180deg);
    background: var(--blue);
    color: var(--white);
  }
  .faq-a {
    padding: 0 var(--s-5) var(--s-5);
    color: var(--muted);
  }
  /* the answer opens by height and fades in; closing is instant. Without ::details-content / interpolate-size
     the answer simply opens at once. */
  .faq-item {
    interpolate-size: allow-keywords;
  }
  .faq-item::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
  }
  .faq-item[open]::details-content {
    block-size: auto;
    opacity: 1;
    transition:
      block-size 250ms var(--ease-out),
      opacity 250ms var(--ease-out);
  }
  /* reduced motion: no height change, only the fade (base.css cuts durations to 0.01ms with !important) */
  @media (prefers-reduced-motion: reduce) {
    .faq-item[open]::details-content {
      transition: opacity 250ms var(--ease-out);
      transition-duration: 250ms !important;
    }
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }
  }
  @media (max-width: 560px) {
    .faq-q {
      min-height: 56px;
      padding-left: var(--s-4);
      font-size: var(--fs-base);
    }
    .faq-a {
      padding: 0 var(--s-4) var(--s-4);
      font-size: var(--fs-sm);
    }
  }
</style>
