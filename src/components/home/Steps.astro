---
// «Как заказать»: four cards in a row joined by a line through their icons (icons instead of numbers).
// ≤ 900px — a column with the line on the left. Under them — «Посчитать цену».
import SectionHead from '@/components/ui/SectionHead.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { steps } from '@/data/home';
---

<section class="section steps-sec" aria-labelledby="steps-title">
  <div class="wrap">
    <SectionHead id="steps-title" title="Как" accent="заказать" />
    <ol class="steps" role="list">
      {
        steps.map((s) => (
          <li class="step">
            <span class="step-ic">
              <Icon name={s.icon} size={26} />
            </span>
            <div class="step-card">
              <h3 class="step-title">{s.title}</h3>
              <p class="step-text">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="steps-cta">
      <Button href="/price" arrow>Посчитать цену</Button>
    </div>
  </div>
</section>

<style>
  .steps {
    --dot: 64px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5);
  }
  /* the line through the icon centres, from the first icon to the last */
  .steps::before {
    content: '';
    position: absolute;
    top: calc(var(--dot) / 2 - 1px);
    left: calc((100% - 3 * var(--s-5)) / 8);
    right: calc((100% - 3 * var(--s-5)) / 8);
    border-top: 2px dashed #a9c1ef;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
  }
  .step-ic {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--blue);
    color: var(--white);
    box-shadow:
      0 0 0 8px var(--sky-2),
      var(--shadow-btn);
  }
  .step-card {
    flex: 1;
    width: 100%;
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--white);
    box-shadow: var(--shadow-card);
    text-align: center;
  }
  .step-title {
    margin-bottom: var(--s-2);
  }
  .step-text {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .steps-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--s-7);
  }

  @media (max-width: 900px) {
    .steps {
      --dot: 52px;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-4);
    }
    .steps::before {
      top: calc(var(--dot) / 2);
      bottom: calc(var(--dot) / 2);
      left: calc(var(--dot) / 2 - 1px);
      right: auto;
      border-top: 0;
      border-left: 2px dashed #a9c1ef;
    }
    .step {
      flex-direction: row;
      align-items: flex-start;
    }
    .step-ic {
      flex: none;
    }
    .step-card {
      text-align: left;
      padding: var(--s-4) var(--s-5);
    }
    .steps-cta {
      margin-top: var(--s-6);
    }
  }
  @media (max-width: 560px) {
    .step-ic {
      box-shadow:
        0 0 0 6px var(--sky-2),
        var(--shadow-btn);
    }
    .step-card {
      padding: var(--s-4);
    }
    .steps-cta :global(.btn) {
      width: 100%;
    }
  }
</style>
