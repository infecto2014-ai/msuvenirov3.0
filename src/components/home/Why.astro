---
// «Почему выбирают нас»: four reasons — an icon in a light-blue circle, a title, a line of text. ≤ 900px — 2×2.
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import { why } from '@/data/home';
---

<section class="section why-sec" aria-labelledby="why-title">
  <div class="wrap">
    <SectionHead id="why-title" title="Почему выбирают" accent="нас" />
    <ul class="why" role="list">
      {
        why.map((w) => (
          <li class="why-item">
            <span class="why-ic">
              <Icon name={w.icon} size={28} />
            </span>
            <h3 class="why-title">{w.title}</h3>
            <p class="why-text">{w.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6);
  }
  .why-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
  }
  .why-ic {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: var(--s-3);
    border-radius: 50%;
    background: var(--sky);
    color: var(--blue);
  }
  .why-title {
    font-size: var(--fs-lg);
  }
  .why-text {
    color: var(--muted);
    max-width: 17rem;
  }
  @media (max-width: 900px) {
    .why {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-6) var(--s-5);
    }
  }
  @media (max-width: 560px) {
    .why {
      gap: var(--s-5) var(--s-4);
    }
    .why-ic {
      width: 52px;
      height: 52px;
      margin-bottom: var(--s-1);
    }
    .why-title {
      font-size: var(--fs-base);
    }
    .why-text {
      font-size: var(--fs-sm);
    }
  }
</style>
