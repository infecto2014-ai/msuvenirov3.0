---
// Home first screen: h1 with the blue accent, subtitle, two buttons.
// Desktop: the 2400×1400 scene follows the content width (its right edge sits at the .wrap column, not the window),
// so the cat stays next to the text on wide monitors; its empty light left part goes under the text.
// ≤ 900px: a square picture under the text instead. Only one copy is displayed at any width (the other is
// display:none), so assistive tech gets exactly one picture with the alt.
import Button from '@/components/ui/Button.astro';
import Pic from '@/components/ui/Pic.astro';
import { site } from '@/data/site';

const alt = 'Рыжий кот в фартуке у термопресса с футболкой, рядом стопка кружек';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media">
    <Pic name="hero" alt={alt} w={1467} h={993} loading="eager" fetchpriority="high" hiddenMedia="(max-width: 900px)" label="hero — сцена с котом" class="hero-pic" />
  </div>

  <div class="wrap hero-in">
    <div class="hero-text">
      <h1 id="hero-title" class="hero-title">
        Печать на&nbsp;одежде <br class="hero-br" />и&nbsp;сувенирах в&nbsp;Калининграде <br class="hero-br" />
        <span class="accent">
          от 1 штуки
          <svg class="accent-squiggle" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M4 20C52 12 104 8 166 6.5L118 17.5c28-3.5 54-5 78-4.5" />
          </svg>
        </span>
      </h1>
      <p class="hero-sub">Сельма, {site.address.place}</p>
      <div class="hero-actions">
        <Button href="#catalog" arrow>Выбрать изделие</Button>
        <Button href={site.constructorUrl} variant="ghost" icon="pencil" target="_blank" rel="noopener">Создать свой дизайн <span class="visually-hidden">(откроется в новой вкладке)</span></Button>
      </div>
    </div>

    <div class="hero-mobile">
      <Pic name="hero-mobile" alt={alt} w={1200} h={812} loading="eager" fetchpriority="high" hiddenMedia="(min-width: 901px)" label="hero-mobile" class="hero-mpic" />
    </div>
  </div>
</section>

<style>
  .hero {
    /* right edge of the text column: the picture's empty left half may go under the text, its subject may not */
    --text-max: 36rem;
    --text-edge: calc(max((100vw - var(--wrap)) / 2, var(--gutter)) + var(--text-max) + var(--s-5));
    position: relative;
    isolation: isolate;
    /* room for the facts strip that overlaps the bottom edge */
    padding-block: var(--s-8) calc(var(--s-9) + var(--s-6));
    background:
      radial-gradient(42rem 26rem at 78% 40%, rgba(21, 87, 255, 0.1), transparent 70%),
      linear-gradient(180deg, var(--sky-2), var(--sky) 70%, rgba(234, 242, 255, 0));
    overflow: hidden;
  }
  .hero-in {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 460px;
  }
  .hero-text {
    max-width: var(--text-max);
  }

  /* desktop: the owner's cut-out cat (16.11.2026: «кот в 2 раза больше») stands right of the buttons, on the facts
     strip: from just past the buttons (the text column start + 31rem) to the content edge + --s-8, never past the
     window. Its top-left corner is empty, so it may reach above the end of the heading's long line; the hero is
     taller so the tail stays below the heading. */
  .hero-media {
    --pic-left: calc(max((100vw - var(--wrap)) / 2, var(--gutter)) + 31rem);
    --pic-right: max(var(--s-4), calc((100vw - var(--wrap)) / 2 - var(--s-8)));
    position: absolute;
    z-index: 0;
    right: var(--pic-right);
    bottom: calc(var(--s-9) + var(--s-6) - var(--s-5));
    width: min(calc(100vw - var(--pic-left) - var(--pic-right)), 60rem);
    aspect-ratio: 1467 / 993;
  }
  .hero-media :global(.hero-pic) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right bottom;
  }
  /* no photo yet: the placeholder keeps to the right half, never under the text */
  .hero-media :global(.pic-ph) {
    width: 52%;
    margin-left: auto;
    aspect-ratio: auto !important;
    border-radius: var(--radius-panel) 0 0 var(--radius-panel);
  }

  /* owner, 16.11.2026: the heading in Helvetica (system font: Helvetica on Apple devices, Arial elsewhere) */
  .hero-title {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(2.125rem, 1.2rem + 3vw, 3.5rem);
  }
  .accent {
    position: relative;
    display: inline-block;
    color: var(--blue);
    white-space: nowrap;
  }
  .accent-squiggle {
    position: absolute;
    left: 6%;
    bottom: -0.36em;
    width: 100%;
    height: 0.42em;
    overflow: visible;
    fill: none;
    stroke: var(--blue);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .hero-sub {
    margin-top: var(--s-6);
    max-width: 30rem;
    color: var(--muted);
    font-size: var(--fs-lg);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-6);
  }

  .hero-mobile {
    display: none;
  }

  /* Once, on load (pure CSS, does not wait for JS or scrolling): the heading, the subtitle and the buttons fade in
     60ms apart, without moving; the cat settles from 102% to 100% while it fades in. The facts strip stays still.
     fill-mode `both` keeps the delayed lines hidden until their turn, so nothing flashes first. */
  .hero-title,
  .hero-sub,
  .hero-actions {
    animation: hero-fade 400ms var(--ease-out) both;
  }
  .hero-sub {
    animation-delay: 60ms;
  }
  .hero-actions {
    animation-delay: 120ms;
  }
  .hero-media,
  .hero-mobile {
    animation: hero-settle 600ms var(--ease-out) both;
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes hero-settle {
    from {
      opacity: 0;
      transform: scale(1.02);
    }
  }
  /* reduced motion: everything fades in together, no scale (base.css cuts durations to 0.01ms with !important) */
  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-sub,
    .hero-actions,
    .hero-media,
    .hero-mobile {
      animation: hero-fade 400ms var(--ease-out) both;
      animation-delay: 0ms;
      animation-duration: 400ms !important;
    }
  }

  /* desktop (≥ 1240px): the heading in exactly three lines — «Печать на одежде / и сувенирах в Калининграде /
     от 1 штуки». The column is as wide as the long middle line (about 13.9em), the heading a little smaller than
     before, and the picture is sized so that the leftmost part of the cat (its tail, at about 37% of the picture's
     width) stays clear of the text: picture width = (its right edge − the text edge) / 0.63.
     Narrower screens keep the four-line heading: there three lines would leave the cat too small. */
  .hero-br {
    display: none;
  }
  @media (min-width: 1240px) {
    .hero {
      --text-max: 42.5rem;
    }
    .hero-br {
      display: inline;
    }
    .hero-title {
      font-size: 3rem;
      text-wrap: wrap;
    }
    .hero-in {
      min-height: 560px;
    }
  }

  @media (max-width: 1100px) {
    .hero {
      /* both buttons still fit on one line at 1024 */
      --text-max: 31rem;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: var(--s-7) calc(var(--s-8) + var(--s-5));
    }
    .hero-media {
      display: none;
    }
    .hero-in {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-6);
      min-height: 0;
    }
    .hero {
      --text-max: 40rem;
    }
    .hero-mobile {
      position: relative;
      display: block;
      width: 100%;
      /* the cut-out cat with the press, as wide as the column (owner: «кот в 2 раза больше») */
      max-width: 680px;
      margin-inline: auto;
    }
  }

  @media (max-width: 560px) {
    .hero-sub {
      margin-top: var(--s-5);
      font-size: var(--fs-base);
    }
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
