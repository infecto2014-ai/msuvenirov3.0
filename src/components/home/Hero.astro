---
// Home first screen: label, h1 with the blue accent, subtitle, two buttons.
// Desktop: the 2400×1400 scene sits on the right like a background (its empty light left part goes under the text).
// ≤ 900px: a square picture under the text instead. Only one copy is displayed at any width (the other is
// display:none), so assistive tech gets exactly one picture with the alt. Rays and the crown near the cat are decorative SVG.
import Button from '@/components/ui/Button.astro';
import Pic from '@/components/ui/Pic.astro';
import { site } from '@/data/site';

const alt = 'Кот в худи с логотипом мастерской рядом с кружкой и ноутбуком';
const decor = `
<svg class="hd-rays" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M40 6 33 22"/><path d="M58 22 41 31"/><path d="M8 18l20 12"/></svg>
<svg class="hd-crown" viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 40 4 10l16 14L32 4l12 20 16-14-2 30Z"/><path d="M8 44h48"/></svg>`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media">
    <Pic name="hero" alt={alt} w={2400} h={1400} loading="eager" label="hero — сцена с котом" class="hero-pic" />
    <div class="hero-decor" set:html={decor} />
  </div>

  <div class="wrap hero-in">
    <div class="hero-text">
      <p class="hero-label">Печать и сувениры в Калининграде</p>
      <h1 id="hero-title" class="hero-title">
        Печатаем на футболках, кружках и сувенирах&nbsp;—{' '}
        <span class="accent">
          от 1 штуки
          <svg class="accent-squiggle" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M4 20C52 12 104 8 166 6.5L118 17.5c28-3.5 54-5 78-4.5" />
          </svg>
        </span>
      </h1>
      <p class="hero-sub">Подарки с вашим фото и мерч с логотипом компании. <span class="nowrap">{site.address.place}</span></p>
      <div class="hero-actions">
        <Button href="#catalog" arrow>Выбрать изделие</Button>
        <Button href={site.constructorUrl} variant="ghost" icon="pencil" target="_blank" rel="noopener">Создать свой дизайн</Button>
      </div>
    </div>

    <div class="hero-mobile">
      <Pic name="hero-mobile" alt={alt} w={1200} h={1200} label="hero-mobile" class="hero-mpic" />
      <div class="hero-decor" set:html={decor} />
    </div>
  </div>
</section>

<style>
  .hero {
    /* right edge of the text column: the picture's empty left half may go under the text, its subject may not */
    --text-max: 36rem;
    --text-edge: calc(max((100vw - var(--wrap)) / 2, var(--gutter)) + var(--text-max) + var(--s-5));
    position: relative;
    isolation: isolate;
    /* room for the facts strip that overlaps the bottom edge */
    padding-block: var(--s-8) calc(var(--s-9) + var(--s-6));
    background:
      radial-gradient(42rem 26rem at 78% 40%, rgba(21, 87, 255, 0.1), transparent 70%),
      linear-gradient(180deg, var(--sky-2), var(--sky) 70%, rgba(234, 242, 255, 0));
    overflow: hidden;
  }
  .hero-in {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 460px;
  }
  .hero-text {
    max-width: var(--text-max);
  }

  /* desktop picture in its 2400×1400 proportions, anchored bottom-right: as tall as the hero, but never so large
     that its right half (the scene) reaches under the text */
  .hero-media {
    position: absolute;
    z-index: 0;
    right: 0;
    bottom: 0;
    height: min(100%, calc(2 * (100vw - var(--text-edge)) * 1400 / 2400));
    aspect-ratio: 2400 / 1400;
    /* the left and bottom edges melt into the background (the hero's own background fades out at the bottom) */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%), linear-gradient(0deg, transparent 0, #000 16%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0, #000 22%), linear-gradient(0deg, transparent 0, #000 16%);
    mask-composite: intersect;
  }
  .hero-media :global(.hero-pic) {
    width: 100%;
    height: 100%;
    object-position: right center;
  }
  /* no photo yet: the placeholder keeps to the right half, never under the text */
  .hero-media :global(.pic-ph) {
    width: 52%;
    margin-left: auto;
    aspect-ratio: auto !important;
    border-radius: var(--radius-panel) 0 0 var(--radius-panel);
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero-label::before {
    content: '';
    width: 28px;
    height: 3px;
    border-radius: 2px;
    background: var(--blue);
  }
  .hero-title {
    font-size: clamp(2.125rem, 1.2rem + 3vw, 3.5rem);
  }
  .accent {
    position: relative;
    display: inline-block;
    color: var(--blue);
    white-space: nowrap;
  }
  .accent-squiggle {
    position: absolute;
    left: 6%;
    bottom: -0.36em;
    width: 100%;
    height: 0.42em;
    overflow: visible;
    fill: none;
    stroke: var(--blue);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .hero-sub {
    margin-top: var(--s-6);
    max-width: 30rem;
    color: var(--muted);
    font-size: var(--fs-lg);
  }
  .nowrap {
    white-space: nowrap;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-6);
  }

  /* decor sits over the picture in its own proportions, so it stays next to the cat */
  .hero-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: var(--blue);
  }
  .hero-decor :global(.hd-rays) {
    position: absolute;
    left: 53%;
    top: 30%;
    width: 7%;
  }
  .hero-decor :global(.hd-crown) {
    position: absolute;
    left: 78%;
    top: 10%;
    width: 8%;
    transform: rotate(8deg);
  }

  .hero-mobile {
    display: none;
  }

  @media (max-width: 1100px) {
    .hero {
      --text-max: 30rem;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-block: var(--s-7) calc(var(--s-8) + var(--s-5));
    }
    .hero-media {
      display: none;
    }
    .hero-in {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-6);
      min-height: 0;
    }
    .hero {
      --text-max: 40rem;
    }
    .hero-mobile {
      position: relative;
      display: block;
      width: 100%;
      max-width: 520px;
      margin-inline: auto;
      border-radius: var(--radius-panel);
    }
    .hero-mobile :global(.hero-mpic) {
      border-radius: var(--radius-panel);
    }
    .hero-mobile .hero-decor :global(.hd-rays) {
      left: 10%;
      top: 22%;
      width: 12%;
    }
    .hero-mobile .hero-decor :global(.hd-crown) {
      left: 72%;
      top: 6%;
      width: 14%;
    }
  }

  @media (max-width: 560px) {
    .hero-label {
      font-size: var(--fs-xs);
      letter-spacing: 0.1em;
      margin-bottom: var(--s-4);
    }
    .hero-sub {
      margin-top: var(--s-5);
      font-size: var(--fs-base);
    }
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
