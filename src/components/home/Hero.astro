---
// Home first screen, by the owner's mockup of 16.11.2026 (docs/design-refs/home-hero-2026-11-16.webp,
// spec docs/superpowers/specs/2026-11-16-home-hero-mockup-design.md; the pill «Своя мастерская в Калининграде»
// removed by the owner's second mockup): a three-line heading with the squiggle and a heart under «Калининграде», three advantages, two buttons, the
// address; on the right the shared cat art (HeroArt: blob, crown, strokes, shadow). One grid, the DOM order is
// heading → cat → perks → buttons → address: on desktop the cat spans the right column, ≤ 900px (phone mockup
// docs/design-refs/home-hero-mobile-2026-11-16.webp) everything is one column in that order, the perks in one
// row of three.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import HeroArt from '@/components/ui/HeroArt.astro';
import { site } from '@/data/site';

const alt = 'Термопресс, белые футболки, кружки и материалы для печати';
---

<section class="hero" aria-labelledby="hero-title">
  <svg class="hero-waves" viewBox="0 0 1440 640" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="w1" d="M0 250C180 190 300 330 470 380C640 430 760 560 900 640H0Z" />
    <path class="w2" d="M0 420C200 360 360 470 560 560C620 590 680 620 720 640H0Z" />
    <path class="w3" d="M1440 120C1300 170 1220 300 1260 430C1290 520 1370 590 1440 610Z" />
  </svg>

  <div class="wrap hero-in">
    <h1 id="hero-title" class="hero-title">
      Печать на&nbsp;одежде <br />и&nbsp;сувенирах <br />в&nbsp;<span class="accent"
        >Калининграде<svg class="accent-squiggle" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M4 20C52 12 104 8 166 6.5L118 17.5c28-3.5 54-5 78-4.5" />
        </svg><svg class="accent-heart" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" />
        </svg></span
      >
    </h1>

    <HeroArt name="hero" w={1448} h={1086} mobileName="hero-mobile" mw={1448} mh={1086} alt={alt} label="изделия и оборудование для печати" class="hero-cat" />

    <ul class="hero-perks" role="list">
      <li><Icon name="shirt" size={30} /><span>Печать <b>от&nbsp;1&nbsp;штуки</b></span></li>
      <li><Icon name="zap" size={30} /><span>Быстрое изготовление</span></li>
      <li><Icon name="star" size={30} /><span>Качественные материалы</span></li>
    </ul>

    <div class="hero-actions">
      <Button href="#catalog" arrow>Выбрать изделие</Button>
      <Button href={site.constructorUrl} variant="ghost" icon="pencil" target="_blank" rel="noopener">Создать свой дизайн <span class="visually-hidden">(откроется в новой вкладке)</span></Button>
    </div>

    <p class="hero-sub"><Icon name="map-pin" size={20} /> Сельма, {site.address.place}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    /* room for the facts strip that overlaps the bottom edge */
    padding-block: var(--s-7) calc(var(--s-9) + var(--s-6));
    background: linear-gradient(180deg, var(--sky-2), #eef0ff 70%, rgba(238, 240, 255, 0));
    overflow: hidden;
  }
  /* soft lilac hills at the edges, behind everything */
  .hero-waves {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }
  .hero-waves .w1 {
    fill: rgba(170, 182, 246, 0.22);
  }
  .hero-waves .w2 {
    fill: rgba(150, 164, 244, 0.18);
  }
  .hero-waves .w3 {
    fill: rgba(170, 182, 246, 0.2);
  }

  /* one grid: text in the left column (centred vertically by the 1fr rows), the cat spans the right column */
  .hero-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    grid-template-rows: 1fr auto auto auto auto 1fr;
    grid-template-areas:
      '. art'
      'title art'
      'perks art'
      'actions art'
      'sub art'
      '. art';
    column-gap: var(--s-6);
  }
  .hero-title {
    grid-area: title;
  }
  .hero-in > :global(.hero-cat) {
    grid-area: art;
    align-self: center;
  }
  .hero-perks {
    grid-area: perks;
  }
  .hero-actions {
    grid-area: actions;
  }
  .hero-sub {
    grid-area: sub;
  }

  .hero-title {
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.06;
    font-size: clamp(2.25rem, 1.3rem + 3.2vw, 4rem);
  }
  .accent {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }
  .accent-squiggle {
    position: absolute;
    left: 2%;
    bottom: -0.3em;
    width: 100%;
    height: 0.4em;
    overflow: visible;
    fill: none;
    stroke: var(--blue);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .accent-heart {
    position: absolute;
    right: -0.62em;
    bottom: -0.18em;
    width: 0.5em;
    height: 0.5em;
    fill: none;
    stroke: var(--blue);
    stroke-width: 2.4;
    stroke-linejoin: round;
    transform: rotate(-12deg);
  }

  .hero-perks {
    display: flex;
    flex-wrap: wrap;
    margin: var(--s-7) 0 0;
    list-style: none;
    padding: 0;
  }
  .hero-perks li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    max-width: 12rem;
    padding-inline: var(--s-5);
    color: var(--ink);
    font-size: var(--fs-base);
    font-weight: 500;
    line-height: 1.3;
  }
  .hero-perks li:first-child {
    padding-left: 0;
  }
  .hero-perks li + li {
    border-left: 1px solid var(--line);
  }
  .hero-perks :global(svg) {
    flex: none;
    color: var(--blue);
  }
  .hero-perks b {
    display: block;
    color: var(--blue);
    font-weight: 700;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-6);
  }
  .hero-sub {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-5);
    color: var(--muted);
    font-size: var(--fs-base);
  }

  /* Once, on load (pure CSS): the text fades in without moving (the cat settles inside HeroArt). */
  .hero-title,
  .hero-perks,
  .hero-actions,
  .hero-sub {
    animation: hero-fade 400ms var(--ease-out) both;
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  /* laptops and tablets in landscape: a narrower art column, the heading in three lines, the perks compact */
  @media (max-width: 1180px) and (min-width: 901px) {
    .hero-in {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      column-gap: var(--s-5);
    }
    .hero-title {
      font-size: clamp(2.5rem, 1rem + 2.6vw, 3rem);
    }
    .hero-perks {
      margin-top: var(--s-6);
    }
    .hero-perks li {
      max-width: 10.5rem;
      padding-inline: var(--s-3);
      font-size: var(--fs-sm);
    }
  }

  /* phone mockup: heading → cat → perks in one row of three → buttons full width → address centred */
  @media (max-width: 900px) {
    .hero {
      padding-block: var(--s-6) calc(var(--s-8) + var(--s-5));
    }
    .hero-in {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: 'title' 'art' 'perks' 'actions' 'sub';
    }
    .hero-in > :global(.hero-cat) {
      margin-top: var(--s-5);
    }
    .hero-perks {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 620px;
      width: 100%;
      margin: var(--s-4) auto 0;
    }
    .hero-perks li,
    .hero-perks li:first-child {
      flex-direction: column;
      gap: var(--s-2);
      max-width: none;
      padding-inline: var(--s-2);
      text-align: center;
    }
    .hero-actions {
      flex-direction: column;
      max-width: 620px;
      width: 100%;
      margin-inline: auto;
    }
    .hero-actions :global(.btn) {
      width: 100%;
    }
    .hero-sub {
      justify-content: center;
      text-align: center;
    }
  }

  @media (max-width: 560px) {
    .hero-perks li,
    .hero-perks li:first-child {
      padding-inline: var(--s-1);
      font-size: var(--fs-sm);
    }
    .hero-perks :global(svg) {
      width: 28px;
      height: 28px;
    }
  }
</style>
