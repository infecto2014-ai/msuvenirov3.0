---
// «Конструктор» banner after the owner's reference: a low wide light-blue plate with soft waves; text and button
// on the left, a big white T-shirt (transparent picture) right on the plate. On its chest — a dashed print frame
// with handles and the owner's real logo, a cursor at the frame's corner; beside the shirt — a pill with three
// tools and a pill with four colours. All the decor is drawn in code and hidden from screen readers.
// ≤ 900px — stacked: text on top, the shirt under it.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Pic from '@/components/ui/Pic.astro';
import { site } from '@/data/site';
import logoSvg from '@/assets/logo.svg?raw';

const logo = logoSvg.replace('<svg ', '<svg class="cb-logo" aria-hidden="true" focusable="false" ');
---

<section class="section cb-sec" aria-labelledby="cb-title">
  <div class="wrap">
    <div class="cb">
      <svg class="cb-waves" viewBox="0 0 1240 440" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M300 440C420 300 520 190 700 150s360-30 540-120V440Z" fill="#1557ff" fill-opacity=".07" />
        <path d="M0 250c210-40 380 70 590 40s360-170 650-120V440H0Z" fill="#fff" fill-opacity=".5" />
        <path d="M0 360c200-40 380 20 600 0s400-110 640-70V440H0Z" fill="#fff" fill-opacity=".55" />
        <path d="M1240 0H900c60 60 150 90 340 70Z" fill="#fff" fill-opacity=".3" />
      </svg>

      <div class="cb-text">
        <p class="cb-label">Конструктор</p>
        <h2 id="cb-title" class="cb-title">
          Создайте свой <span class="cb-accent">уникальный сувенир</span>
        </h2>
        <p class="cb-lead">Загрузите дизайн, добавьте текст или воспользуйтесь конструктором</p>
        <Button href={site.constructorUrl} arrow target="_blank" rel="noopener">Перейти в конструктор <span class="visually-hidden">(откроется в новой вкладке)</span></Button>
      </div>

      <div class="cb-visual">
        <div class="cb-tee">
          <Pic
            name="constructor-tee"
            alt="Белая футболка с логотипом в рамке принта, как в конструкторе"
            w={1254}
            h={1254}
            fit="contain"
            label="constructor-tee"
            class="cb-pic"
          />
          <span class="cb-frame" aria-hidden="true">
            <span class="cb-h cb-h1"></span>
            <span class="cb-h cb-h2"></span>
            <span class="cb-h cb-h3"></span>
            <span class="cb-h cb-h4"></span>
            <span class="cb-logo-wrap" set:html={logo} />
            <svg class="cb-cursor" viewBox="0 0 24 24" focusable="false"><path d="M3.5 2.5 21 11.2l-7.6 2.2-3.6 7.3Z" /></svg>
          </span>
        </div>
        <span class="cb-tools" aria-hidden="true">
          <Icon name="type" size={26} />
          <Icon name="image" size={26} />
          <Icon name="layers" size={26} />
        </span>
        <span class="cb-colors" aria-hidden="true">
          <span class="cb-dot" style="--c: #ffffff"></span>
          <span class="cb-dot" style="--c: #b8c2d4"></span>
          <span class="cb-dot" style="--c: var(--blue)"></span>
          <span class="cb-dot" style="--c: var(--ink)"></span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .cb-sec {
    padding-top: 0;
  }
  /* --tee: size of the square shirt picture; --cx: where the shirt's centre stands on the plate */
  .cb {
    --tee: 640px;
    --cx: 63%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 440px;
    padding: var(--s-7) var(--s-7);
    border-radius: var(--radius-panel);
    background:
      radial-gradient(30rem 24rem at var(--cx) 45%, rgba(21, 87, 255, 0.2), transparent 70%),
      radial-gradient(24rem 30rem at 100% 0%, rgba(21, 87, 255, 0.14), transparent 70%),
      linear-gradient(90deg, var(--sky-2) 0%, var(--sky) 40%, #d6e5ff 100%);
  }
  .cb-waves {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }
  .cb-text {
    position: relative;
    z-index: 1;
    max-width: 30rem;
  }
  .cb-label {
    margin-bottom: var(--s-3);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cb-title {
    font-size: clamp(1.75rem, 1.1rem + 1.9vw, 2.75rem);
  }
  .cb-accent {
    color: var(--blue);
  }
  .cb-lead {
    margin: var(--s-4) 0 var(--s-6);
    max-width: 23rem;
    font-size: var(--fs-lg);
  }

  /* the shirt stands right on the plate, collar and hem cut by its edges like in the reference */
  .cb-visual {
    position: absolute;
    left: calc(var(--cx) - var(--tee) / 2);
    top: calc(var(--tee) * -0.07);
    width: var(--tee);
  }
  .cb-tee {
    position: relative;
  }
  .cb-tee :global(.cb-pic) {
    filter: drop-shadow(0 18px 30px rgba(21, 87, 255, 0.16));
  }
  .cb-tee :global(.cb-pic.pic-ph) {
    border-radius: var(--radius-card);
    background-color: rgba(255, 255, 255, 0.6);
  }

  /* print area on the chest, in the picture's coordinates (the shirt spans x 7–93 %, armpits at ≈ 41 %) */
  .cb-frame {
    position: absolute;
    left: 32%;
    top: 21%;
    width: 36%;
    height: 28%;
    display: grid;
    place-items: center;
    border: 2px dashed var(--blue);
    border-radius: 4px;
  }
  .cb-logo-wrap {
    display: block;
    width: 72%;
    color: var(--ink);
  }
  .cb-logo-wrap :global(.cb-logo) {
    display: block;
    width: 100%;
    height: auto;
  }
  .cb-h {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 2px solid var(--blue);
    border-radius: 50%;
    background: var(--white);
  }
  .cb-h1 {
    left: -8px;
    top: -8px;
  }
  .cb-h2 {
    right: -8px;
    top: -8px;
  }
  .cb-h3 {
    left: -8px;
    bottom: -8px;
  }
  .cb-h4 {
    right: -8px;
    bottom: -8px;
  }
  .cb-cursor {
    position: absolute;
    right: -30px;
    bottom: -34px;
    width: 36px;
    height: 36px;
    fill: var(--ink);
    stroke: var(--white);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  /* editor tools to the right of the shirt and the colour pill at its lower right */
  .cb-tools {
    position: absolute;
    left: 100%;
    top: 13%;
    display: flex;
    flex-direction: column;
    width: max-content;
    gap: 18px;
    padding: 18px 14px;
    border-radius: var(--radius-pill);
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-card);
  }
  .cb-colors {
    position: absolute;
    left: 88%;
    top: 63%;
    display: flex;
    width: max-content;
    gap: 10px;
    padding: 10px 12px;
    border-radius: var(--radius-pill);
    background: var(--white);
    box-shadow: var(--shadow-card);
  }
  .cb-tools :global(.icon) {
    flex: none;
    max-width: none;
  }
  .cb-dot {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(11, 26, 63, 0.14);
  }

  @media (max-width: 1240px) {
    .cb {
      --tee: 560px;
      --cx: 64%;
      min-height: 420px;
    }
  }
  @media (max-width: 1100px) {
    .cb {
      --tee: 450px;
      --cx: 69%;
      min-height: 380px;
      padding: var(--s-6);
    }
    .cb-text {
      max-width: 46%;
    }
    .cb-title {
      font-size: clamp(1.75rem, 0.9rem + 1.9vw, 2.25rem);
    }
    .cb-lead {
      font-size: var(--fs-base);
    }
    .cb-tools {
      gap: 12px;
      padding: 12px 10px;
    }
    .cb-tools :global(.icon) {
      width: 22px;
      height: 22px;
    }
    .cb-colors {
      left: 78%;
      gap: 8px;
      padding: 8px 10px;
    }
    .cb-dot {
      width: 24px;
      height: 24px;
    }
    .cb-cursor {
      width: 30px;
      height: 30px;
      right: -24px;
      bottom: -28px;
    }
  }

  @media (max-width: 900px) {
    /* stacked: text on top, the shirt under it, its hem cut by the bottom edge of the plate */
    .cb {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-4);
      min-height: 0;
      padding: var(--s-6) var(--s-5) 0;
    }
    .cb-text {
      max-width: none;
    }
    .cb-visual {
      position: relative;
      left: -28px;
      top: auto;
      width: min(100% - 56px, 440px);
      margin-inline: auto;
      aspect-ratio: 1 / 0.8;
      min-height: 0;
    }
    .cb-tee {
      margin-top: -5%;
    }
    .cb-tools {
      left: calc(100% + 6px);
      top: 10%;
    }
    .cb-colors {
      left: auto;
      right: -48px;
      top: 70%;
    }
  }
  @media (max-width: 560px) {
    .cb {
      padding: var(--s-5) var(--s-4) 0;
      border-radius: var(--radius-card);
    }
    .cb-label {
      font-size: var(--fs-xs);
    }
    .cb-lead {
      margin-bottom: var(--s-5);
    }
    .cb-text :global(.btn) {
      width: 100%;
    }
    .cb-visual {
      left: -22px;
      width: calc(100% - 44px);
    }
    .cb-tools {
      left: calc(100% + 2px);
      gap: 8px;
      padding: 10px 7px;
    }
    .cb-tools :global(.icon) {
      width: 18px;
      height: 18px;
    }
    .cb-colors {
      right: -40px;
      gap: 6px;
      padding: 6px 8px;
    }
    .cb-dot {
      width: 18px;
      height: 18px;
    }
    .cb-h {
      width: 10px;
      height: 10px;
    }
    .cb-h1,
    .cb-h3 {
      left: -6px;
    }
    .cb-h2,
    .cb-h4 {
      right: -6px;
    }
    .cb-h1,
    .cb-h2 {
      top: -6px;
    }
    .cb-h3,
    .cb-h4 {
      bottom: -6px;
    }
    .cb-cursor {
      width: 22px;
      height: 22px;
      right: -16px;
      bottom: -20px;
    }
  }
</style>
