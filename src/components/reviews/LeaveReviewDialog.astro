---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/data/site';
const places = [
  { name: '2ГИС', href: site.twoGis },
  { name: 'Яндекс Карты', href: site.ratings.find(p => p.platform === 'Яндекс Карты')!.href },
];
---
<dialog id="review-dialog" class="review-dialog" aria-labelledby="review-dialog-title" aria-describedby="review-dialog-description">
  <button class="review-dialog-close" type="button" aria-label="Закрыть окно отзывов" data-review-close><Icon name="x" size={22}/></button>
  <span class="review-dialog-icon" aria-hidden="true"><Icon name="pencil" size={26}/></span>
  <h2 id="review-dialog-title">Оставить отзыв</h2>
  <p id="review-dialog-description">Выберите удобную площадку и расскажите, как всё прошло. Спасибо за обратную связь!</p>
  <div class="review-dialog-links">
    {places.map(p => <Button href={p.href} variant="ghost" target="_blank" rel="noopener noreferrer" arrow>{p.name}<span class="visually-hidden"> — оставить отзыв (новая вкладка)</span></Button>)}
  </div>
  <p class="review-dialog-note">Ссылка откроется в новой вкладке. Для отзыва может понадобиться вход в аккаунт площадки.</p>
</dialog>
<noscript>
  <div id="review-links" class="review-fallback">
    <p>Оставить отзыв:</p>
    {places.map(p => <a href={p.href} target="_blank" rel="noopener noreferrer">{p.name}<span class="visually-hidden"> (новая вкладка)</span></a>)}
  </div>
</noscript>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#review-dialog');
  if (dialog) {
    let opener: HTMLElement | null = null;
    document.querySelectorAll<HTMLElement>('[data-review-open]').forEach(trigger => {
      trigger.addEventListener('click', event => {
        event.preventDefault();
        if (dialog.open) return;
        opener = trigger;
        dialog.showModal();
        dialog.querySelector<HTMLAnchorElement>('a')?.focus();
      });
    });
    dialog.querySelector('[data-review-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', event => {
      if (event.key !== 'Tab') return;
      const controls = Array.from(dialog.querySelectorAll<HTMLElement>('button, a[href]'));
      const first = controls[0], last = controls.at(-1);
      if (!first || !last) return;
      const atBoundary = event.shiftKey ? document.activeElement === first : document.activeElement === last;
      if (atBoundary || !dialog.contains(document.activeElement)) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
      }
    });
    const outside = (event: MouseEvent) => {
      const r = dialog.getBoundingClientRect();
      return event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom;
    };
    let startedOutside = false;
    dialog.addEventListener('pointerdown', event => { startedOutside = event.target === dialog && outside(event); });
    dialog.addEventListener('click', event => { if (startedOutside && event.target === dialog && outside(event)) dialog.close(); });
    dialog.addEventListener('close', () => { opener?.focus({ preventScroll: true }); });
  }
</script>
<style>
  .review-dialog { position:fixed; inset:0; margin:auto; width:min(460px,calc(100% - 32px)); max-height:calc(100dvh - 32px); overflow-y:auto; padding:var(--s-6); color:var(--ink); background:var(--white); border:1px solid var(--line); border-radius:var(--radius-panel); box-shadow:var(--shadow-pop); }
  .review-dialog::backdrop { background:rgba(11,26,63,.55); }
  :global(body:has(#review-dialog[open])) { overflow:hidden; }
  .review-dialog-close { position:absolute; right:var(--s-3); top:var(--s-3); display:grid; place-items:center; width:44px; height:44px; padding:0; border:0; border-radius:50%; color:var(--ink); background:var(--sky-2); cursor:pointer; transition:background var(--t-fast); }
  .review-dialog-close:hover { background:var(--sky); }
  .review-dialog-icon { display:grid; place-items:center; width:56px; height:56px; margin-bottom:var(--s-4); border-radius:var(--radius-md); color:var(--blue); background:var(--sky); }
  h2 { font-size:var(--fs-h3); } #review-dialog-description { color:var(--muted); margin-top:var(--s-3); }
  .review-dialog-links { display:grid; gap:var(--s-3); margin-top:var(--s-5); }
  .review-dialog-note { font-size:var(--fs-sm); color:var(--muted); margin-top:var(--s-4); }
  .review-fallback { margin-top:var(--s-4); scroll-margin-top:calc(var(--header-h) + var(--s-4)); }
  .review-fallback a { display:inline-flex; align-items:center; min-height:44px; margin-right:var(--s-5); color:var(--blue); }
  @media(max-width:560px) { .review-dialog { padding:var(--s-5); border-radius:var(--radius-card); } }
</style>
