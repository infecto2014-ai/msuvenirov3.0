---
import { reviews } from '@/data/reviews';
import { site } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
const excerpt = (text: string) => {
  if (text.length <= 280) return text;
  const end = text.lastIndexOf(' ', 260);
  return text.slice(0, end > 0 ? end : 260) + '…';
};
---
<section id="customer-reviews" class="section review-section" aria-labelledby="customer-reviews-title" data-review-list>
  <div class="wrap">
    <SectionHead id="customer-reviews-title" title="Слова наших" accent="клиентов" lead="Сохранили имена, даты и площадки. Длинные отзывы можно раскрыть целиком." />
    <p class="review-count" role="status" aria-live="polite" aria-atomic="true">Всего отзывов: {reviews.length}</p>
    <ul id="review-cards" class="review-grid" role="list">
      {reviews.map(r => {
        const platform = site.ratings.find(p => p.platform === r.source);
        const long = r.text.length > 280;
        return <li class="review-card" data-review-source={r.source} tabindex="-1">
          <div class="review-meta">
            <span class="review-avatar" aria-hidden="true">{r.name.charAt(0)}</span>
            <div><h3>{r.name}</h3>{r.date && <p>{r.date}</p>}</div>
          </div>
          {r.rating && <p class="review-stars"><span aria-hidden="true">{Array.from({length: 5}, (_, i) => <Icon name="star" size={17} class={i < r.rating! ? 'star-on' : ''} />)}</span><span class="visually-hidden">Оценка {r.rating} из 5</span></p>}
          {long ? <details class="review-text">
            <summary aria-label={`Отзыв: ${r.name}. Читать полностью или свернуть`}>
              <span class="review-excerpt">{excerpt(r.text)}</span>
              <span class="review-expand">Читать полностью <Icon name="chevron-down" size={16}/></span>
              <span class="review-collapse">Свернуть <Icon name="chevron-down" size={16}/></span>
            </summary>
            <blockquote><p>{r.text}</p></blockquote>
          </details> : <blockquote class="review-short"><p>{r.text}</p></blockquote>}
          {platform && <a class="review-source" href={platform.href} target="_blank" rel="noopener noreferrer" aria-label={`Открыть отзывы на ${platform.platform} (новая вкладка)`}>{platform.platform}<Icon name="arrow-right" size={17}/></a>}
        </li>;
      })}
    </ul>
    <div class="review-more" hidden><Button variant="ghost" data-review-more>Показать ещё</Button></div>
  </div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-review-list]');
  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-review-source]'));
    const status = root.querySelector<HTMLElement>('.review-count')!;
    const moreWrap = root.querySelector<HTMLElement>('.review-more')!;
    const more = root.querySelector<HTMLButtonElement>('[data-review-more]')!;
    let limit = 9;
    const render = () => {
      const items = cards;
      const shown = new Set(items.slice(0, limit));
      cards.forEach(card => { card.hidden = !shown.has(card); });
      status.textContent = `Показано ${Math.min(limit, items.length)} из ${items.length}`;
      moreWrap.hidden = limit >= items.length;
      more.textContent = `Показать ещё ${Math.min(9, Math.max(0, items.length - limit))}`;
    };
    more.addEventListener('click', () => {
      const next = cards[limit];
      limit += 9;
      render();
      next?.focus({ preventScroll: true });
      next?.scrollIntoView({ block: 'nearest' });
    });
    render();
  }
</script>
<style>
  .review-section { background:var(--sky-2); scroll-margin-top:calc(var(--header-h) + var(--s-4)); }
  [hidden] { display:none !important; }
  .review-count { color:var(--muted); font-size:var(--fs-sm); margin-bottom:var(--s-5); }
  .review-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--s-5); align-items:start; }
  .review-card { display:flex; flex-direction:column; min-width:0; gap:var(--s-4); padding:var(--s-5); background:var(--white); border:1px solid var(--line); border-radius:var(--radius-card); box-shadow:var(--shadow-card); overflow-wrap:anywhere; }
  .review-card:focus-visible { outline:3px solid var(--focus); outline-offset:4px; }
  .review-meta { display:flex; align-items:center; gap:var(--s-3); }
  .review-avatar { display:grid; place-items:center; flex:none; width:44px; height:44px; background:var(--sky); color:var(--blue); border-radius:50%; font-weight:800; }
  h3 { font-size:var(--fs-base); } .review-meta p { font-size:var(--fs-sm); color:var(--muted); margin-top:var(--s-1); }
  blockquote { margin:0; } .review-stars>span { display:flex; gap:2px; } .review-stars :global(.star-on) { color:var(--blue); fill:currentColor; }
  .review-text summary { list-style:none; cursor:pointer; } .review-text summary::-webkit-details-marker { display:none; }
  .review-expand,.review-collapse { display:flex; align-items:center; gap:var(--s-1); color:var(--blue); font-weight:600; font-size:var(--fs-sm); min-height:44px; margin-top:var(--s-1); }
  .review-collapse { display:none; } .review-text[open] .review-excerpt,.review-text[open] .review-expand { display:none; }
  .review-text[open] .review-collapse { display:flex; margin-top:0; } .review-collapse :global(svg) { transform:rotate(180deg); }
  .review-source { display:flex; align-items:center; justify-content:space-between; min-height:44px; border-top:1px solid var(--line); padding-top:var(--s-3); color:var(--blue); font-size:var(--fs-sm); font-weight:600; text-decoration:none; }
  .review-source:hover { text-decoration:underline; } .review-more { text-align:center; margin-top:var(--s-6); }
  @media(max-width:1100px) { .review-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:560px) { .review-grid { grid-template-columns:minmax(0,1fr); gap:var(--s-4); } .review-card{padding:var(--s-4);} }
</style>
