---
// The owner's logo (CorelDRAW original, text converted to paths). Colour follows `currentColor`:
// ink on light backgrounds, white with `inverse`. Decorative here — wrap it in a link with its own label.
import logoSvg from '@/assets/logo.svg?raw';

interface Props {
  inverse?: boolean;
  /** height in px */
  size?: number;
  class?: string;
}
const { inverse = false, size = 44, class: cls } = Astro.props;
const svg = logoSvg.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---

<span class:list={['logo', { inverse }, cls]} style={`--logo-h: ${size}px`} set:html={svg} />

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    flex: none;
    color: var(--ink);
  }
  .logo.inverse {
    color: var(--white);
  }
  .logo :global(svg) {
    display: block;
    height: var(--logo-h);
    width: auto;
  }
</style>
