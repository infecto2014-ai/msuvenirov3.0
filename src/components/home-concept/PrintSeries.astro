---
const filters = [
  { group: 'all', label: 'Все' },
  { group: 'wear', label: 'Одежда' },
  { group: 'mug', label: 'Кружки' },
  { group: 'shopper', label: 'Шопперы' },
];

const pieces = [
  {
    group: 'wear',
    label: 'Печать на одежде',
    href: '/pechat-na-odezhde',
    image: 'sea-sweatshirt.png',
    width: 1536,
    height: 1024,
    alt: 'Тёмно-зелёный свитшот с рисунком волны',
  },
  {
    group: 'mug',
    label: 'Печать на кружках',
    href: '/pechat-na-kruzhkah',
    image: 'sea-mug.png',
    width: 1536,
    height: 1024,
    alt: 'Белая кружка с рисунком маяка',
  },
  {
    group: 'shopper',
    label: 'Печать на шопперах',
    href: '/pechat-na-shopperah',
    image: 'sea-shopper.png',
    width: 1312,
    height: 1199,
    alt: 'Светлый шоппер с рисунком парусника',
  },
];
---

<section class="series" id="print-series" aria-labelledby="print-series-title" data-print-series>
  <div class="series-intro">
    <div class="series-heading">
      <h2 id="print-series-title">На чём печатаем</h2>
      <p>Примеры принтов. Ваш дизайн — на выбранной вещи.</p>
    </div>
    <div class="filters" role="group" aria-label="Виды изделий" data-print-filters hidden>
      {filters.map(({ group, label }) => (
        <button type="button" data-filter={group} aria-pressed={group === 'all' ? 'true' : 'false'} aria-controls="print-examples">
          {label}
        </button>
      ))}
    </div>
    <span class="visually-hidden" role="status" data-print-status></span>
  </div>

  <ul class="collage" role="list" id="print-examples" data-print-examples>
    {pieces.map(({ group, label, href, image, width, height, alt }) => (
      <li class:list={['piece', `piece--${group}`]} data-piece={group}>
        <a class="piece-link" href={href}>
          <span class="piece-label">{label}</span>
          <img src={`/img/merch-concept/${image}`} {width} {height} {alt} loading="lazy" decoding="async" />
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  for (const section of document.querySelectorAll('[data-print-series]')) {
    const filters = section.querySelector<HTMLElement>('[data-print-filters]');
    const examples = section.querySelector<HTMLElement>('[data-print-examples]');
    const status = section.querySelector('[data-print-status]');
    if (!filters || !examples || !status) continue;

    const buttons = filters.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const pieces = examples.querySelectorAll<HTMLElement>('[data-piece]');

    for (const button of buttons) {
      button.addEventListener('click', () => {
        if (button.getAttribute('aria-pressed') === 'true') return;

        const group = button.dataset.filter;
        const all = group === 'all';
        for (const option of buttons) {
          option.setAttribute('aria-pressed', String(option === button));
        }
        let visible = 0;
        for (const piece of pieces) {
          piece.hidden = !all && piece.dataset.piece !== group;
          if (!piece.hidden) visible += 1;
        }
        examples.toggleAttribute('data-filtered', !all);
        status.textContent = `Показано изделий: ${visible}`;
      });
    }

    filters.hidden = false;
  }
</script>

<style>
  .series {
    --edge: clamp(1.125rem, 4.2vw, 4.75rem);

    max-width: 105rem;
    margin-inline: auto;
    color: var(--merch-ink);
    container-type: inline-size;
  }

  .series-intro {
    padding: clamp(1.1rem, 3.1cqi, 3.1rem) var(--edge) .5rem;
  }

  .series-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .45rem 1.5rem;
  }

  .series-heading h2 {
    font-size: clamp(2.25rem, 5.8cqi, 5.1rem);
    font-weight: 740;
    line-height: 1.04;
    letter-spacing: -.05em;
  }

  .series-heading p {
    max-inline-size: 30rem;
    color: var(--merch-muted);
    font-size: clamp(.875rem, 1.45cqi, 1.15rem);
    line-height: 1.35;
    text-wrap: pretty;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(.9rem, 3.6cqi, 3.5rem);
    margin-block-start: clamp(.3rem, .9cqi, .9rem);
  }

  .filters[hidden],
  .piece[hidden] {
    display: none;
  }

  .filters button {
    position: relative;
    min-height: 44px;
    padding: 0 .1em;
    border: 0;
    background: transparent;
    font-size: clamp(1rem, 1.8cqi, 1.4rem);
    font-weight: 500;
    line-height: 1;
  }

  .filters button[aria-pressed='true'] {
    font-weight: 750;
  }

  .filters button[aria-pressed='true']::after {
    position: absolute;
    inset: auto -.04em 1px;
    height: .26em;
    background: var(--merch-lime);
    clip-path: polygon(0 98%, 19% 54%, 44% 22%, 75% 8%, 100% 41%, 81% 58%, 58% 62%, 30% 83%);
    content: '';
  }

  .filters button:hover {
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .collage {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: clip;
  }

  .piece {
    min-width: 0;
  }

  .piece--wear {
    grid-column: 1 / -1;
    width: 92%;
    height: clamp(15.5rem, 78cqi, 32rem);
    margin-inline-start: -1%;
  }

  .piece--mug {
    height: clamp(11.5rem, 54cqi, 22rem);
    margin-block-start: -.4rem;
  }

  .piece--shopper {
    width: 106%;
    height: clamp(14rem, 65cqi, 29rem);
    margin-inline-start: -6%;
  }

  .piece-link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .piece img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 12px 10px var(--merch-shadow));
  }

  .piece--mug .piece-link {
    isolation: isolate;
  }

  .piece--mug .piece-link::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: auto auto 1% 11%;
    width: 43%;
    height: 11%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgb(16 16 16 / .28), transparent 70%);
    filter: blur(5px);
    pointer-events: none;
  }

  .piece--wear img {
    object-position: left bottom;
  }

  .piece-label {
    position: absolute;
    z-index: 1;
    inset: .45rem auto auto var(--edge);
    max-width: min(8.5em, 72%);
    font-size: clamp(.875rem, 1.5cqi, 1.375rem);
    font-weight: 550;
    line-height: 1.2;
    text-wrap: balance;
  }

  .piece-label::after {
    position: absolute;
    inset: calc(100% + .24em) auto auto .55em;
    width: clamp(1.15rem, 4.3cqi, 3.9rem);
    height: clamp(1.05rem, 4.8cqi, 4.35rem);
    border-bottom: 2px solid var(--merch-lime);
    border-left: 2px solid var(--merch-lime);
    border-bottom-left-radius: 98%;
    transform: rotate(10deg);
    content: '';
  }

  .piece--shopper .piece-label {
    inset-inline-start: 0;
  }

  .piece-link:hover .piece-label,
  .piece-link:focus-visible .piece-label {
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .piece-link:focus-visible .piece-label {
    outline: 3px solid var(--merch-ink);
    outline-offset: 4px;
  }

  @media (min-width: 45rem) {
    .collage {
      position: relative;
      display: block;
      height: clamp(28rem, 49cqi, 49rem);
    }

    .piece {
      position: absolute;
      margin: 0;
    }

    .piece--wear {
      inset: 7% auto 0 -2%;
      width: 57.5%;
      height: auto;
    }

    .piece--wear img {
      position: absolute;
      inset: auto auto -3% -5%;
      width: 112%;
      height: auto;
      transform: rotate(-9deg);
    }

    .piece--wear .piece-label {
      inset: 0 auto auto 14%;
    }

    .piece--mug {
      z-index: 2;
      inset: 0 0 auto auto;
      width: 43.5%;
      height: 36%;
    }

    .piece--mug img {
      width: 69%;
      height: 100%;
      object-position: left center;
      transform: none;
    }

    .piece--mug .piece-label {
      inset: .45rem 9% auto auto;
      max-width: 6.5em;
    }

    .piece--mug .piece-label::after {
      inset-inline-start: 0;
      transform: scaleX(-1) rotate(10deg);
    }

    .piece--shopper {
      z-index: 1;
      inset: 36% -2% 0 auto;
      width: 47.5%;
      height: auto;
    }

    .piece--shopper img {
      position: absolute;
      inset: -8% 0 auto auto;
      width: 91%;
      height: auto;
    }

    .piece--shopper .piece-label {
      inset: 1% auto auto 0;
      max-width: 6.5em;
    }

    /* Transparent layout boxes must not steal a neighbouring product's link. */
    .piece--mug,
    .piece--shopper,
    .piece--mug .piece-link,
    .piece--shopper .piece-link {
      pointer-events: none;
    }

    .piece--mug img,
    .piece--shopper img,
    .piece--mug .piece-label,
    .piece--shopper .piece-label {
      pointer-events: auto;
    }
  }

  .collage[data-filtered] {
    display: grid;
    grid-template-columns: minmax(0, 39rem);
    justify-content: center;
    height: auto;
    padding: .75rem var(--edge) 1.5rem;
  }

  .collage[data-filtered] .piece {
    position: relative;
    inset: auto;
    grid-column: 1;
    width: 100%;
    height: clamp(17rem, 52cqi, 35rem);
    margin: 0;
  }

  .collage[data-filtered] img {
    position: static;
    width: 100%;
    height: 100%;
    object-position: center bottom;
    transform: none;
  }

  .collage[data-filtered] .piece-label {
    inset: 0 auto auto 0;
    max-width: 8.5em;
  }

  .collage[data-filtered] .piece-label::after {
    inset-inline-start: .55em;
    transform: rotate(10deg);
  }
</style>
