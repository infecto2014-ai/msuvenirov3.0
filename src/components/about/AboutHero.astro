---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import HeroArt from '@/components/ui/HeroArt.astro';
import { aboutFacts } from '@/data/about';
import { site } from '@/data/site';
---
<section class="about-hero" aria-labelledby="about-title">
  <div class="wrap about-hero-grid">
    <nav class="about-crumbs" aria-label="Хлебные крошки"><ol role="list"><li><a href="/">Главная</a></li><li><Icon name="chevron-right" size={16}/><span aria-current="page">О нас</span></li></ol></nav>
    <div class="about-intro">
      <p class="about-eyebrow">Мастерская сувениров · Калининград</p>
      <h1 id="about-title">Идея ваша.<br/><span>Мастерская наша.<svg viewBox="0 0 440 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 20Q180 2 430 8M300 20l132-12"/></svg></span></h1>
      <p class="about-lead">С {site.founded} года превращаем фотографии, рисунки и любимые фразы в вещи. Печатаем сами — в своей мастерской в ТЦ «Экватор».</p>
    </div>
    <div class="about-hero-picture">
      <HeroArt name="about-hero" w={1355} h={1138} mobileName="about-hero-mobile" mw={900} mh={756} alt="Рыжий кот мастерской у рабочего стола с футболкой и кружкой с синими сердцами" label="кот за рабочим столом"/>
      <span class="about-handnote" aria-hidden="true">Здесь идеи обретают форму<svg viewBox="0 0 100 60"><path d="M4 4Q80 0 80 46M68 37l13 12 12-15"/></svg></span>
    </div>
    <div class="about-actions"><Button data-order="Хочу обсудить идею для печати" icon="pencil">Обсудить идею</Button></div>
    <ul class="about-facts" role="list">{aboutFacts.map(f=><li><strong>{f.value}</strong><span>{f.label}</span></li>)}</ul>
  </div>
</section>
<style>
 .about-hero{position:relative;padding-block:var(--s-6) var(--s-8);background:radial-gradient(ellipse at 85% 80%,var(--sky),transparent 55%),linear-gradient(180deg,var(--sky-2),var(--white));}
 .about-hero-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);grid-template-areas:'crumbs art' 'intro art' 'actions art' 'facts facts';gap:var(--s-5) var(--s-6);align-items:center;}
 .about-crumbs{grid-area:crumbs;font-size:var(--fs-sm);color:var(--muted);}.about-crumbs ol,.about-crumbs li{display:flex;align-items:center;gap:var(--s-2);}.about-crumbs a{color:inherit;text-decoration:none;}.about-crumbs [aria-current]{color:var(--ink);font-weight:600;}
 .about-intro{grid-area:intro;}.about-eyebrow{font-size:var(--fs-sm);color:var(--muted);margin-bottom:var(--s-4);}h1{font-size:clamp(2.2rem,1.5rem + 3vw,3.6rem);line-height:1.12;letter-spacing:-.04em;}h1>span{position:relative;display:inline-block;color:var(--blue);}h1 svg{position:absolute;left:0;bottom:-16px;width:100%;height:24px;fill:none;stroke:var(--blue);stroke-width:3;stroke-linecap:round;}
 .about-lead{max-width:570px;margin-top:var(--s-6);color:var(--muted);font-size:var(--fs-lg);}.about-actions{grid-area:actions;display:flex;flex-wrap:wrap;gap:var(--s-3);align-self:start;}
 .about-hero-picture{grid-area:art;position:relative;align-self:center;}.about-handnote{position:absolute;right:3%;bottom:-12px;max-width:180px;color:var(--blue);font-size:var(--fs-sm);font-weight:600;transform:rotate(-5deg);}.about-handnote svg{position:absolute;right:0;bottom:100%;width:65px;height:48px;transform:rotate(140deg);fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
 .about-facts{grid-area:facts;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:var(--s-6);padding:var(--s-5);border:1px solid var(--line);border-radius:var(--radius-card);background:var(--white);box-shadow:var(--shadow-card);}.about-facts li{display:grid;gap:var(--s-1);padding-inline:var(--s-5);text-align:center;}.about-facts li+li{border-left:1px solid var(--line);}.about-facts strong{font-size:clamp(1.4rem,1rem + 1.4vw,2.2rem);font-weight:800;color:var(--blue);}.about-facts span{color:var(--muted);font-size:var(--fs-sm);}
 @media(max-width:900px){.about-hero-grid{grid-template-columns:minmax(0,1fr);grid-template-areas:'crumbs' 'intro' 'art' 'actions' 'facts';}.about-hero-picture{width:min(100%,540px);justify-self:center;}.about-actions{justify-content:center;}.about-handnote{bottom:-4px;}.about-facts{margin-top:var(--s-3);}.about-intro{max-width:700px;}.about-lead{max-width:650px;}.about-hero{padding-bottom:var(--s-7);}}
 @media(max-width:560px){h1{font-size:clamp(2rem,8.8vw,3rem);}.about-eyebrow{font-size:var(--fs-xs);margin-bottom:var(--s-3);}.about-lead{font-size:var(--fs-base);}.about-actions{display:grid;grid-template-columns:minmax(0,1fr);}.about-actions :global(.btn){white-space:normal;}.about-facts{padding:var(--s-4) var(--s-2);}.about-facts li{padding-inline:var(--s-2);}.about-facts span{font-size:var(--fs-xs);}.about-handnote{display:none;}.about-hero-grid{gap:var(--s-4);}}
</style>
