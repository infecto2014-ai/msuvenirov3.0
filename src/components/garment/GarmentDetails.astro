---
// «Подробнее об изделии»: collapsed sections (<details> — the text stays in the HTML for search engines and opens
// without JS): colours, fabric and specs, extra card sections (`extra`: two kinds of shopper, «DTF или
// сублимация»…), print sizes (a to-scale scheme on the garment's outline, drawn in cm),
// adult and kids size charts (with the measuring cat), care. Every section is optional: one without data is left
// out, and without any the block is not drawn. Texts come from the page's data file (src/data/garments/<page>.ts),
// colours from pricing.ts (garmentColors), outlines from src/data/garments/shapes.ts.
import BadgeLayoutGuide from './BadgeLayoutGuide.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Pic from '@/components/ui/Pic.astro';
import type { DetailCard, GarmentPage } from '@/data/garments/types';
import { garmentColors } from '@/data/garments/select';
import { SHAPES, type GarmentShape } from '@/data/garments/shapes';

interface Props {
  page: GarmentPage;
}
const { page } = Astro.props;
const { colors, specs, sizes, care, prints, extra } = page;
const colorList = garmentColors(page);
const adultSizes = sizes?.adult;
const kidsSizes = sizes?.kids;
const measure = page.images.extra?.measure;

const sections = [
  colors && colorList.length ? { id: 'colors', icon: 'palette', title: 'Цвета', sub: colors.sub } : undefined,
  specs ? { id: 'specs', icon: specs.icon ?? 'shirt', title: specs.title ?? 'Ткань и характеристики', sub: specs.sub } : undefined,
  ...(extra ?? []).map((x) => ({ id: x.id, icon: x.icon, title: x.title, sub: x.sub, cards: x.cards, illustration: x.illustration })),
  prints ? { id: 'prints', icon: 'scan', title: 'Размеры принтов', sub: prints.sub } : undefined,
  sizes ? { id: 'sizes', icon: 'ruler', title: 'Размерный ряд', sub: sizes.sub } : undefined,
  care?.length ? { id: 'care', icon: 'droplets', title: 'Уход', sub: page.careSub ?? 'Как стирать, чтобы принт служил дольше' } : undefined,
].filter((s): s is { id: string; icon: IconName; title: string; sub: string; cards?: DetailCard[]; illustration?: 'badge-layout' } => !!s);

const shape: GarmentShape | undefined = prints ? SHAPES[prints.shape] : undefined;
const frames = prints && shape ? [...prints.sizes].reverse().map((p) => ({ ...p, x: shape.center - p.w / 2, y: shape.top })) : [];
---

{sections.length > 0 && (
<section class="section td-sec" aria-labelledby="td-title">
  <div class="wrap">
    <SectionHead id="td-title" title="Подробнее" accent={page.heads.details} />

    <div class="td">
      {
        sections.map((s) => (
          <details class="td-item" id={`garment-${s.id}`}>
            <summary class="td-q">
              <span class="td-ic">
                <Icon name={s.icon} size={22} />
              </span>
              <span class="td-q-text">
                <span class="td-q-title">{s.title}</span>
                <span class="td-q-sub">{s.sub}</span>
              </span>
              <span class="td-chev">
                <Icon name="chevron-down" size={20} />
              </span>
            </summary>

            <div class="td-a">
              {s.illustration === 'badge-layout' && <BadgeLayoutGuide />}
              {s.id === 'colors' && (
                <ul class="td-colors" role="list">
                  {colorList.map((c) => (
                    <li class="td-color">
                      <span class="td-swatch" style={`--c: ${c.swatch ?? 'transparent'}`} aria-hidden="true" />
                      <span class="td-color-name">{c.label}</span>
                      <span class:list={['td-color-mark', { 'td-color-mark-free': c.free }]}>{c.note}</span>
                    </li>
                  ))}
                </ul>
              )}

              {s.id === 'specs' && specs && (
                <div>
                  <dl class="td-specs">
                    {specs.items.map((x) => (
                      <div class="td-spec">
                        <dt>{x.label}</dt>
                        <dd>{x.value}</dd>
                      </div>
                    ))}
                  </dl>
                  {specs.todo && (
                    <p class="td-note">
                      <Icon name="info" size={20} />
                      <span>Характеристики уточняйте у менеджера</span>
                    </p>
                  )}
                </div>
              )}

              {s.cards && (
                <ul class="td-cards" role="list">
                  {s.cards.map((c) => (
                    <li class="td-card">
                      <h3 class="td-card-title">
                        {c.href ? <a class="td-card-link" href={c.href}>{c.title}</a> : c.title}
                        {c.tag && <span class="td-card-tag">{c.tag}</span>}
                      </h3>
                      {c.rows && (
                        <dl class="td-card-rows">
                          {c.rows.map((r) => (
                            <div class="td-spec">
                              <dt>{r.label}</dt>
                              <dd>{r.value}</dd>
                            </div>
                          ))}
                        </dl>
                      )}
                      {c.points && (
                        <ul class="td-care td-card-points" role="list">
                          {c.points.map((t) => (
                            <li>
                              <span class="td-check">
                                <Icon name="check" size={16} />
                              </span>
                              {t}
                            </li>
                          ))}
                        </ul>
                      )}
                      {c.text && <p class="td-card-text">{c.text}</p>}
                    </li>
                  ))}
                </ul>
              )}

              {s.id === 'prints' && prints && shape && (
                <div class="td-prints">
                  <figure class:list={['td-scheme', `td-scheme-${prints.shape}`]}>
                    <svg viewBox={shape.viewBox} role="img" aria-labelledby="td-scheme-cap" focusable="false">
                      <path class="td-shirt" d={shape.path} />
                      {shape.extra && <path class="td-shirt-extra" d={shape.extra} />}
                      {frames.map((f) => (
                        <g class="td-frame">
                          <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="0.6" />
                          <text x={f.x + f.w - 0.9} y={f.y + f.h - 1}>
                            {f.label}
                          </text>
                        </g>
                      ))}
                    </svg>
                    <figcaption id="td-scheme-cap">{prints.caption}</figcaption>
                  </figure>
                  <ul class="td-print-list" role="list">
                    {prints.sizes.map((p) => (
                      <li>
                        <span class="td-print-box" style={`--w: ${p.w}; --h: ${p.h}`} aria-hidden="true" />
                        <span class="td-print-label">{p.label}</span>
                        <span class="td-print-size">
                          {String(p.w).replace(".", ",")}×{String(p.h).replace(".", ",")} см
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {s.id === 'sizes' && sizes && (
                <div class="td-sizes">
                  <div class="td-tables">
                    {[
                      { title: 'Взрослые', table: adultSizes },
                      { title: 'Детские', table: kidsSizes },
                    ]
                      .filter((t) => t.table)
                      .map(({ title, table }) => (
                        <div class="td-table-block">
                          <h3 class="td-h3">{title}</h3>
                          <div class="td-scroll" tabindex="0" role="region" aria-label={`${title} размеры, прокрутка таблицы`}>
                            <table class="td-table">
                              <thead>
                                <tr>
                                  {table!.columns.map((c) => (
                                    <th scope="col">{c}</th>
                                  ))}
                                </tr>
                              </thead>
                              <tbody>
                                {table!.rows.map((r) => (
                                  <tr>
                                    {r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </div>
                      ))}
                    {sizes.todo && (
                      <p class="td-note">
                        <Icon name="info" size={20} />
                        <span>Размеры ориентировочные — точные мерки уточняйте у менеджера</span>
                      </p>
                    )}
                  </div>
                  <aside class="td-measure" aria-label="Как мерить">
                    {measure && <Pic name={measure} alt="Футболки и оборудование для печати" w={800} h={800} fit="contain" label={measure} class="td-cat" />}
                    {shape && (
                    <figure class="td-abc">
                      <svg viewBox={shape.viewBox} aria-hidden="true" focusable="false">
                        <path class="td-shirt" d={shape.path} />
                        {shape.extra && <path class="td-shirt-extra" d={shape.extra} />}
                        <g class="td-dim">
                          {shape.dims.map((d) => (
                            <path d={d} />
                          ))}
                        </g>
                        <g class="td-dim-label">
                          {shape.labels.map((x) => (
                            <>
                              <circle cx={x.x} cy={x.y} r="3.6" />
                              <text x={x.x} y={x.y + 1.3}>{x.l}</text>
                            </>
                          ))}
                        </g>
                      </svg>
                      <figcaption>
                        {shape.labels.map((x, i) => (
                          <>
                            {i > 0 && ', '}
                            <b>{x.l}</b> — {x.what}
                          </>
                        ))}
                      </figcaption>
                    </figure>
                    )}
                  </aside>
                </div>
              )}

              {s.id === 'care' && care && (
                <ul class="td-care" role="list">
                  {care.map((t) => (
                    <li>
                      <span class="td-check">
                        <Icon name="check" size={16} />
                      </span>
                      {t}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
)}

<style>
  .td {
    display: grid;
    gap: var(--s-3);
  }
  .td-item {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--white);
    transition:
      border-color var(--t-fast) ease,
      box-shadow var(--t) var(--ease);
  }
  .td-item:hover,
  .td-item[open] {
    border-color: #c4d6f5;
    box-shadow: var(--shadow-card);
  }
  .td-q {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 76px;
    padding: var(--s-3) var(--s-4) var(--s-3) var(--s-4);
    border-radius: var(--radius-card);
  }
  .td-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--sky);
    color: var(--blue);
  }
  .td-q-text {
    display: grid;
    flex: 1;
    min-width: 0;
    gap: 2px;
  }
  .td-q-title {
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.3;
  }
  .td-q-sub {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .td-chev {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--sky);
    color: var(--blue);
    transition:
      transform var(--t) var(--ease),
      background-color var(--t-fast) ease,
      color var(--t-fast) ease;
  }
  .td-item[open] .td-chev {
    transform: rotate(180deg);
    background: var(--blue);
    color: var(--white);
  }
  .td-a {
    padding: var(--s-2) var(--s-5) var(--s-5) calc(var(--s-4) + 48px + var(--s-4));
  }
  /* opens by height and fades in (as the home FAQ); reduced motion — fade only */
  .td-item {
    interpolate-size: allow-keywords;
  }
  .td-item::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
  }
  .td-item[open]::details-content {
    block-size: auto;
    opacity: 1;
    transition:
      block-size 250ms var(--ease-out),
      opacity 250ms var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .td-item[open]::details-content {
      transition: opacity 250ms var(--ease-out);
      transition-duration: 250ms !important;
    }
  }

  /* colours */
  .td-colors {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--s-2) var(--s-4);
  }
  .td-color {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
  }
  .td-swatch {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgba(11, 26, 63, 0.18);
  }
  .td-color-name {
    font-weight: 600;
  }
  .td-color-mark {
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--sky-2);
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .td-color-mark-free {
    background: var(--sky);
    color: var(--blue-hover);
  }

  /* specs */
  .td-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--s-6);
    margin: 0;
  }
  .td-spec {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .td-spec dt {
    color: var(--muted);
  }
  .td-spec dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  /* extra card sections (two kinds, two technologies): side by side, stacked ≤ 900px */
  .td-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .td-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    border-radius: var(--radius-card);
    background: var(--sky-2);
  }
  .td-card-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    font-size: var(--fs-lg);
  }
  .td-card-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: #b9c8e6;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition:
      color var(--t-fast) ease,
      text-decoration-color var(--t-fast) ease;
  }
  .td-card-link:hover {
    color: var(--blue);
    text-decoration-color: var(--blue);
  }
  .td-card-tag {
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--sky);
    color: var(--blue-hover);
    font-size: var(--fs-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .td-card-rows {
    margin: 0;
  }
  .td-card-rows .td-spec:last-child {
    border-bottom: 0;
  }
  .td-card-points .td-check {
    background: var(--white);
  }
  .td-card-text {
    margin-top: auto;
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  /* print sizes */
  .td-prints {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--s-6);
  }
  .td-scheme {
    margin: 0;
    padding: var(--s-4);
    border-radius: var(--radius-card);
    background: var(--sky-2);
  }
  .td-scheme svg,
  .td-abc svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* the shopper with its 35 cm handles is tall: keep the scheme as high as the T-shirt one */
  .td-scheme-shopper svg {
    max-height: 440px;
  }
  .td-shirt {
    fill: var(--white);
    stroke: #b9c8e6;
    stroke-width: 0.5;
    stroke-linejoin: round;
  }
  .td-shirt-extra {
    fill: none;
    stroke: #b9c8e6;
    stroke-width: 0.5;
    stroke-linejoin: round;
  }
  .td-frame rect {
    fill: rgba(21, 87, 255, 0.05);
    stroke: var(--blue);
    stroke-width: 0.35;
    stroke-dasharray: 1.2 0.8;
  }
  .td-frame text {
    fill: var(--blue-hover);
    font-size: 2.4px;
    font-weight: 700;
    text-anchor: end;
  }
  .td-scheme figcaption,
  .td-abc figcaption {
    margin-top: var(--s-3);
    color: var(--muted);
    font-size: var(--fs-sm);
    text-align: center;
  }
  .td-print-list {
    display: grid;
    gap: var(--s-3);
  }
  .td-print-list li {
    display: grid;
    grid-template-columns: 48px auto 1fr;
    align-items: center;
    gap: var(--s-4);
    min-height: 56px;
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  /* mini sheets to the same scale: 1 cm = 1.15px */
  .td-print-box {
    justify-self: center;
    width: calc(var(--w) * 1.15px);
    height: calc(var(--h) * 1.15px);
    border: 2px solid var(--blue);
    border-radius: 3px;
    background: var(--sky);
  }
  .td-print-label {
    font-size: var(--fs-lg);
    font-weight: 800;
  }
  .td-print-size {
    justify-self: end;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* size charts */
  .td-sizes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: var(--s-6);
    align-items: start;
  }
  .td-tables {
    display: grid;
    gap: var(--s-5);
  }
  .td-h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-3);
    margin-bottom: var(--s-3);
    font-size: var(--fs-lg);
  }
  /* sizes or specs not confirmed by the owner (`sizes.todo`, `specsTodo`) — a clearly visible note under them */
  .td-note {
    display: flex;
    align-items: flex-start;
    gap: var(--s-2);
    margin-top: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--radius-md);
    background: var(--sky);
    color: var(--ink);
    font-size: var(--fs-base);
  }
  .td-note :global(.icon) {
    flex: none;
    margin-top: 2px;
    color: var(--blue);
  }
  .td-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .td-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
  .td-table th,
  .td-table td {
    padding: 10px var(--s-4);
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  .td-table thead th {
    background: var(--sky-2);
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 700;
    vertical-align: bottom;
  }
  .td-table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .td-table tbody th {
    font-weight: 700;
    white-space: nowrap;
  }
  .td-table tbody tr:hover > * {
    background: var(--sky-2);
  }
  .td-measure {
    display: grid;
    gap: var(--s-4);
    position: sticky;
    top: calc(var(--header-h) + var(--s-4));
  }
  .td-measure :global(.td-cat) {
    border-radius: var(--radius-card);
  }
  .td-abc {
    margin: 0;
    padding: var(--s-4);
    border-radius: var(--radius-card);
    background: var(--sky-2);
  }
  .td-dim path {
    fill: none;
    stroke: var(--blue);
    stroke-width: 0.6;
    stroke-dasharray: 1.4 1;
  }
  .td-dim-label circle {
    fill: var(--blue);
  }
  .td-dim-label text {
    fill: var(--white);
    font-size: 3.6px;
    font-weight: 800;
    text-anchor: middle;
  }

  /* care */
  .td-care {
    display: grid;
    gap: var(--s-3);
  }
  .td-care li {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
  }
  .td-check {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--sky);
    color: var(--blue);
  }

  @media (max-width: 900px) {
    .td-a {
      padding: var(--s-1) var(--s-4) var(--s-5);
    }
    .td-specs {
      grid-template-columns: minmax(0, 1fr);
    }
    .td-cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .td-prints {
      grid-template-columns: minmax(0, 1fr);
    }
    .td-scheme {
      max-width: 460px;
    }
    .td-sizes {
      grid-template-columns: minmax(0, 1fr);
    }
    .td-measure {
      position: static;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      max-width: 560px;
    }
  }
  @media (max-width: 560px) {
    .td-q {
      min-height: 64px;
      gap: var(--s-3);
      padding-inline: var(--s-3);
    }
    .td-ic {
      width: 40px;
      height: 40px;
    }
    .td-q-title {
      font-size: var(--fs-base);
    }
    .td-q-sub {
      font-size: var(--fs-xs);
    }
    .td-a {
      padding: var(--s-1) var(--s-3) var(--s-4);
    }
    .td-colors {
      grid-template-columns: minmax(0, 1fr);
    }
    .td-card {
      padding: var(--s-4);
    }
    .td-color-mark {
      margin-left: auto;
    }
    .td-table th,
    .td-table td {
      padding: 8px var(--s-3);
    }
    .td-measure {
      grid-template-columns: minmax(0, 1fr);
    }
    .td-measure :global(.td-cat) {
      max-width: 240px;
      margin-inline: auto;
    }
  }
</style>
