---
// First screen of a clothing page — the home Hero's standard (owner 16.11.2026, spec
// docs/superpowers/specs/2026-11-16-home-hero-mockup-design.md, «второй макет»): one grid, text on the left
// (breadcrumbs, h1 with the blue accent and squiggle, price «от N ₽» — the cheapest calculator product of the page,
// from pricing.ts — two buttons, the address), the shared cat art (HeroArt) spanning the right column.
// ≤ 900px one column: breadcrumbs → h1 → cat → price → buttons full width → address centred.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import HeroArt from '@/components/ui/HeroArt.astro';
import { site } from '@/data/site';
import { rub } from '@/data/pricing';
import { garmentFrom } from '@/data/garments/select';
import type { GarmentPage } from '@/data/garments/types';

interface Props {
  page: GarmentPage;
}
const { page } = Astro.props;

/** the cheapest garment of the page's tiles with a print */
const from = garmentFrom(page);
const img = page.images;
const crumbs = page.crumbs.slice(0, -1);
const current = page.crumbs.at(-1)!.label;
---

<section class="th" aria-labelledby="th-title">
  <svg class="th-waves" viewBox="0 0 1440 640" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="w1" d="M0 250C180 190 300 330 470 380C640 430 760 560 900 640H0Z" />
    <path class="w2" d="M0 420C200 360 360 470 560 560C620 590 680 620 720 640H0Z" />
    <path class="w3" d="M1440 120C1300 170 1220 300 1260 430C1290 520 1370 590 1440 610Z" />
  </svg>

  <div class="wrap th-in">
    <nav class="th-crumbs" aria-label="Хлебные крошки">
      <ol role="list">
        {
          crumbs.map((c) => (
            <li>
              <a href={c.href}>{c.label}</a>
              <Icon name="chevron-right" size={16} />
            </li>
          ))
        }
        <li><span aria-current="page">{current}</span></li>
      </ol>
    </nav>

    <h1 id="th-title" class="th-title">
      {page.h1}{' '}
      <span class="th-accent">
        {page.accent}
        <svg class="th-squiggle" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M4 20C52 12 104 8 166 6.5L118 17.5c28-3.5 54-5 78-4.5" />
        </svg>
      </span>
    </h1>

    <HeroArt
      name={img.hero}
      w={img.heroSize.w}
      h={img.heroSize.h}
      mobileName={img.heroMobile}
      mw={img.heroMobileSize.w}
      mh={img.heroMobileSize.h}
      alt={img.alt}
      label={img.label}
      class="th-cat"
    />

    <p class="th-price">
      <span class="th-price-label">{page.hero.priceLabel}</span>
      <span class="th-price-value">от&nbsp;{rub(from)}</span>
    </p>

    <div class="th-actions">
      <Button href="#calc" icon="calculator">Рассчитать стоимость</Button>
      {page.showConstructor === false
        ? <Button variant="ghost" icon="send" data-order="">Отправить макет</Button>
        : <Button href={site.constructorUrl} variant="ghost" icon="pencil" target="_blank" rel="noopener">Создать свой дизайн <span class="visually-hidden">(откроется в новой вкладке)</span></Button>}
    </div>

    <p class="th-sub"><Icon name="map-pin" size={20} /> Сельма, {site.address.place}</p>
  </div>
</section>

<style>
  .th {
    position: relative;
    isolation: isolate;
    padding-block: var(--s-6) var(--s-8);
    background: linear-gradient(180deg, var(--sky-2), #eef0ff 70%, rgba(238, 240, 255, 0));
    overflow: hidden;
  }
  /* the same soft lilac hills as the home first screen */
  .th-waves {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    /* no facts strip below (unlike the home): the hills melt into the page instead of ending on a hard line */
    -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
  }
  .th-waves .w1 {
    fill: rgba(170, 182, 246, 0.22);
  }
  .th-waves .w2 {
    fill: rgba(150, 164, 244, 0.18);
  }
  .th-waves .w3 {
    fill: rgba(170, 182, 246, 0.2);
  }

  /* the home grid: text centred vertically by the 1fr rows, the cat spans the right column */
  .th-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto auto auto auto auto 1fr;
    grid-template-areas:
      '. art'
      'crumbs art'
      'title art'
      'price art'
      'actions art'
      'sub art'
      '. art';
    column-gap: var(--s-6);
  }
  .th-crumbs {
    grid-area: crumbs;
  }
  .th-title {
    grid-area: title;
  }
  .th-in > :global(.th-cat) {
    grid-area: art;
    align-self: center;
    /* keeps the first screen compact for portrait cats too */
    max-width: 600px;
    justify-self: center;
  }
  .th-price {
    grid-area: price;
    justify-self: start;
  }
  .th-actions {
    grid-area: actions;
  }
  .th-sub {
    grid-area: sub;
  }

  /* breadcrumbs: Главная › Печать на одежде › Футболки */
  .th-crumbs {
    margin-bottom: var(--s-4);
    font-size: var(--fs-sm);
  }
  .th-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-1);
    margin: 0;
    padding: 0;
  }
  .th-crumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--muted);
  }
  .th-crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--t-fast) ease;
  }
  .th-crumbs a:hover {
    color: var(--blue-hover);
    text-decoration: underline;
  }
  .th-crumbs :global(.icon) {
    color: #9aa7c2;
  }
  .th-crumbs [aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  .th-title {
    font-size: clamp(2.125rem, 1.2rem + 3vw, 3.25rem);
  }
  .th-accent {
    position: relative;
    display: inline-block;
    color: var(--blue);
    white-space: nowrap;
  }
  .th-squiggle {
    position: absolute;
    left: 6%;
    bottom: -0.36em;
    width: 100%;
    height: 0.42em;
    overflow: visible;
    fill: none;
    stroke: var(--blue);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* price plate: a white pill with the label and the big «от N ₽» */
  .th-price {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-7);
    padding: var(--s-3) var(--s-5);
    border-radius: var(--radius-pill);
    background: var(--white);
    box-shadow: var(--shadow-card);
  }
  .th-price-label {
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .th-price-value {
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .th-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-6);
  }
  .th-sub {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-5);
    color: var(--muted);
    font-size: var(--fs-base);
  }

  /* once, on load: the text fades in without moving (the cat settles inside HeroArt) */
  .th-title,
  .th-price,
  .th-actions,
  .th-sub {
    animation: th-fade 400ms var(--ease-out) both;
  }
  .th-price,
  .th-sub {
    animation-delay: 60ms;
  }
  .th-actions {
    animation-delay: 120ms;
  }
  @keyframes th-fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .th-title,
    .th-price,
    .th-actions,
    .th-sub {
      animation-delay: 0ms;
    }
  }

  @media (max-width: 1180px) and (min-width: 901px) {
    .th-in {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      column-gap: var(--s-5);
    }
  }

  /* phone: breadcrumbs → h1 → cat → price → buttons full width → address centred */
  @media (max-width: 900px) {
    .th {
      padding-block: var(--s-5) var(--s-7);
    }
    .th-in {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: 'crumbs' 'title' 'art' 'price' 'actions' 'sub';
    }
    .th-in > :global(.th-cat) {
      margin-top: var(--s-5);
      max-width: 520px;
      justify-self: stretch;
    }
    .th-price {
      justify-self: center;
      margin-top: var(--s-4);
    }
    .th-actions {
      flex-direction: column;
      max-width: 620px;
      width: 100%;
      margin-inline: auto;
    }
    .th-actions :global(.btn) {
      width: 100%;
    }
    .th-sub {
      justify-content: center;
      text-align: center;
    }
  }

  @media (max-width: 560px) {
    .th-crumbs {
      margin-bottom: var(--s-3);
    }
    .th-price {
      padding: var(--s-3) var(--s-4);
    }
    .th-price-value {
      font-size: 1.25rem;
    }
  }
</style>
