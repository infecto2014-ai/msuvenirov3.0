---
// First screen of a clothing page — the home Hero's composition: breadcrumbs, h1 with the blue accent and squiggle,
// subtitle, price «от N ₽» (the cheapest calculator product of the page, from pricing.ts), two buttons; the cat scene
// on the right (≤ 900px — a square picture under the text). Until the owner's pictures arrive, Pic shows labelled
// placeholders in the same slots.
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Pic from '@/components/ui/Pic.astro';
import { site } from '@/data/site';
import { rub } from '@/data/pricing';
import { garmentFrom } from '@/data/garments/select';
import type { GarmentPage } from '@/data/garments/types';

interface Props {
  page: GarmentPage;
}
const { page } = Astro.props;

/** the cheapest garment of the page's tiles with a print */
const from = garmentFrom(page);
const alt = page.images.alt;
const crumbs = page.crumbs.slice(0, -1);
const current = page.crumbs.at(-1)!.label;
---

<section class="th" aria-labelledby="th-title">
  <div class="th-media">
    <Pic name={page.images.hero} alt={alt} w={2400} h={1400} loading="eager" fetchpriority="high" hiddenMedia="(max-width: 900px)" label={`${page.images.hero} — ${page.images.label}`} class="th-pic" />
  </div>

  <div class="wrap th-in">
    <div class="th-text">
      <nav class="th-crumbs" aria-label="Хлебные крошки">
        <ol role="list">
          {
            crumbs.map((c) => (
              <li>
                <a href={c.href}>{c.label}</a>
                <Icon name="chevron-right" size={16} />
              </li>
            ))
          }
          <li><span aria-current="page">{current}</span></li>
        </ol>
      </nav>

      <h1 id="th-title" class="th-title">
        {page.h1}{' '}
        <span class="th-accent">
          {page.accent}
          <svg class="th-squiggle" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M4 20C52 12 104 8 166 6.5L118 17.5c28-3.5 54-5 78-4.5" />
          </svg>
        </span>
      </h1>
      <p class="th-sub">Сельма, {site.address.place}</p>

      <p class="th-price">
        <span class="th-price-label">{page.hero.priceLabel}</span>
        <span class="th-price-value">от&nbsp;{rub(from)}</span>
      </p>

      <div class="th-actions">
        <Button href="#calc" icon="calculator">Рассчитать стоимость</Button>
        <Button href={site.constructorUrl} variant="ghost" icon="pencil" target="_blank" rel="noopener">Создать свой дизайн <span class="visually-hidden">(откроется в новой вкладке)</span></Button>
      </div>
    </div>

    <div class="th-mobile">
      <Pic name={page.images.heroMobile} alt={alt} w={1200} h={1200} loading="eager" fetchpriority="high" hiddenMedia="(min-width: 901px)" label={page.images.heroMobile} class="th-mpic" />
    </div>
  </div>
</section>

<style>
  .th {
    --text-max: 38rem;
    --text-edge: calc(max((100vw - var(--wrap)) / 2, var(--gutter)) + var(--text-max) + var(--s-5));
    position: relative;
    isolation: isolate;
    padding-block: var(--s-6) var(--s-8);
    background:
      radial-gradient(42rem 26rem at 78% 40%, rgba(21, 87, 255, 0.1), transparent 70%),
      linear-gradient(180deg, var(--sky-2), var(--sky) 70%, rgba(234, 242, 255, 0));
    overflow: hidden;
  }
  .th-in {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 460px;
  }
  .th-text {
    max-width: var(--text-max);
  }

  /* the 2400×1400 scene, anchored bottom-right like the home hero; its empty left part may go under the text */
  .th-media {
    position: absolute;
    z-index: 0;
    right: max(0px, calc((100vw - var(--wrap)) / 2 - var(--s-8)));
    bottom: 0;
    height: min(100%, calc(2 * (100vw - var(--text-edge)) * 1400 / 2400));
    aspect-ratio: 2400 / 1400;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0, #000 22%, #000 92%, transparent 100%),
      linear-gradient(0deg, transparent 0, #000 16%),
      linear-gradient(180deg, transparent 0, #000 5%);
    -webkit-mask-composite: source-in, source-in;
    mask-image:
      linear-gradient(90deg, transparent 0, #000 22%, #000 92%, transparent 100%),
      linear-gradient(0deg, transparent 0, #000 16%),
      linear-gradient(180deg, transparent 0, #000 5%);
    mask-composite: intersect;
  }
  .th-media :global(.th-pic) {
    width: 100%;
    height: 100%;
    object-position: right center;
  }
  /* no picture yet: the placeholder keeps to the right half, never under the text, and is not masked away */
  .th-media:has(.pic-ph) {
    -webkit-mask-image: none;
    mask-image: none;
    top: var(--s-6);
    bottom: var(--s-8);
    height: auto;
  }
  .th-media :global(.pic-ph) {
    width: 48%;
    height: 100%;
    margin-left: auto;
    aspect-ratio: auto !important;
    border-radius: var(--radius-panel);
  }

  /* breadcrumbs: Главная › Печать на одежде › Футболки */
  .th-crumbs {
    margin-bottom: var(--s-5);
    font-size: var(--fs-sm);
  }
  .th-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-1);
    margin: 0;
    padding: 0;
  }
  .th-crumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--muted);
  }
  .th-crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--t-fast) ease;
  }
  .th-crumbs a:hover {
    color: var(--blue-hover);
    text-decoration: underline;
  }
  .th-crumbs :global(.icon) {
    color: #9aa7c2;
  }
  .th-crumbs [aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  .th-title {
    font-size: clamp(2.125rem, 1.2rem + 3vw, 3.25rem);
  }
  .th-accent {
    position: relative;
    display: inline-block;
    color: var(--blue);
    white-space: nowrap;
  }
  .th-squiggle {
    position: absolute;
    left: 6%;
    bottom: -0.36em;
    width: 100%;
    height: 0.42em;
    overflow: visible;
    fill: none;
    stroke: var(--blue);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .th-sub {
    margin-top: var(--s-6);
    color: var(--muted);
    font-size: var(--fs-lg);
  }

  /* price plate: a white pill with the label and the big «от N ₽» */
  .th-price {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-5);
    padding: var(--s-3) var(--s-5);
    border-radius: var(--radius-pill);
    background: var(--white);
    box-shadow: var(--shadow-card);
  }
  .th-price-label {
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .th-price-value {
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .th-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-6);
  }

  .th-mobile {
    display: none;
  }

  /* once, on load: text fades in without moving, the scene settles (same as the home hero) */
  .th-title,
  .th-sub,
  .th-price,
  .th-actions {
    animation: th-fade 400ms var(--ease-out) both;
  }
  .th-sub,
  .th-price {
    animation-delay: 60ms;
  }
  .th-actions {
    animation-delay: 120ms;
  }
  .th-media,
  .th-mobile {
    animation: th-settle 600ms var(--ease-out) both;
  }
  @keyframes th-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes th-settle {
    from {
      opacity: 0;
      transform: scale(1.02);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .th-title,
    .th-sub,
    .th-price,
    .th-actions,
    .th-media,
    .th-mobile {
      animation: th-fade 400ms var(--ease-out) both;
      animation-delay: 0ms;
      animation-duration: 400ms !important;
    }
  }

  @media (max-width: 1100px) {
    .th {
      /* both buttons on one line at 1024 */
      --text-max: 34rem;
    }
  }

  @media (max-width: 900px) {
    .th {
      --text-max: 40rem;
      padding-block: var(--s-5) var(--s-7);
    }
    .th-media {
      display: none;
    }
    .th-in {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-6);
      min-height: 0;
    }
    .th-mobile {
      display: block;
      width: 100%;
      max-width: 520px;
      margin-inline: auto;
      border-radius: var(--radius-panel);
    }
    .th-mobile :global(.pic-ph) {
      border-radius: var(--radius-panel);
    }
  }

  @media (max-width: 560px) {
    .th-crumbs {
      margin-bottom: var(--s-3);
    }
    .th-sub {
      margin-top: var(--s-5);
      font-size: var(--fs-base);
    }
    .th-price {
      padding: var(--s-3) var(--s-4);
    }
    .th-price-value {
      font-size: 1.25rem;
    }
    .th-actions {
      flex-direction: column;
    }
    .th-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
