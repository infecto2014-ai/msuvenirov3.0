---
// Price table of a clothing page («Цена печати на футболках»): the last block, always open (no JS needed,
// indexable). The tables are the `table` of the page's calculator products in pricing.ts (blank by run + DTF print
// A6–A3); the rules under them (colour minimum, every next print −30 %) come from the page's data.
import SectionHead from '@/components/ui/SectionHead.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { findProduct } from '@/data/pricing';
import type { GarmentPage } from '@/data/garments/types';

interface Props {
  page: GarmentPage;
}
const { prices, calc } = Astro.props.page;

const tables = prices.products.map((t) => ({ ...t, table: findProduct(calc.category, t.id)!.table! }));
const rules = prices.rules;
---

<section class="section tpr-sec" aria-labelledby="tpr-title">
  <div class="wrap">
    <SectionHead id="tpr-title" title={prices.title} accent={prices.accent} lead={prices.lead} />

    <div class:list={['tpr-tables', { 'tpr-one': tables.length === 1 }]}>
      {
        tables.map(({ title, table }) => (
          <div class="tpr-block">
            <h3 class="tpr-h3">{title}</h3>
            <div class="tpr-scroll" tabindex="0" role="region" aria-label={`${title}: цены по тиражам, прокрутка таблицы`}>
              <table class="tpr-table">
                <thead>
                  <tr>
                    <th scope="col">{prices.unitLabel ?? 'За 1 шт'}</th>
                    {table.columns.map((c) => (
                      <th scope="col">{c}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {table.rows.map((r) => (
                    <tr>
                      <th scope="row">{r.label}</th>
                      {r.cells.map((c) => (
                        <td>{c}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {table.note && <p class="tpr-note muted">{table.note}</p>}
          </div>
        ))
      }
    </div>

    <ul class="tpr-rules" role="list">
      {
        rules.map((r) => (
          <li class="tpr-rule">
            <span class="tpr-rule-ic">
              <Icon name={r.icon} size={22} />
            </span>
            <span>{r.text}</span>
          </li>
        ))
      }
    </ul>

    <div class="tpr-more">
      <Button href="/price" variant="ghost" arrow>Все цены</Button>
    </div>
  </div>
</section>

<style>
  .tpr-tables {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
    align-items: start;
  }
  /* one product (e.g. only the hoodie): the table takes the whole row */
  .tpr-tables.tpr-one {
    grid-template-columns: minmax(0, 1fr);
  }
  .tpr-block {
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--white);
    box-shadow: var(--shadow-card);
  }
  .tpr-h3 {
    margin-bottom: var(--s-3);
    font-size: var(--fs-lg);
  }
  .tpr-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .tpr-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
  .tpr-table th,
  .tpr-table td {
    padding: 10px var(--s-4);
    text-align: left;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  .tpr-table thead th {
    background: var(--sky-2);
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 700;
    vertical-align: bottom;
  }
  .tpr-table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .tpr-table tbody th {
    font-weight: 700;
  }
  .tpr-table tbody tr:hover > * {
    background: var(--sky-2);
  }
  .tpr-note {
    margin-top: var(--s-3);
    font-size: var(--fs-sm);
  }
  .tpr-rules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-5);
  }
  .tpr-rule {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border-radius: var(--radius-card);
    background: var(--sky);
    font-weight: 600;
  }
  .tpr-rule-ic {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--white);
    color: var(--blue);
  }
  .tpr-more {
    margin-top: var(--s-5);
  }
  @media (max-width: 1100px) {
    .tpr-tables {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 900px) {
    .tpr-rules {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }
  }
  @media (max-width: 560px) {
    .tpr-block {
      padding: var(--s-4);
    }
    .tpr-table th,
    .tpr-table td {
      padding: 8px var(--s-3);
    }
    .tpr-rule {
      padding: var(--s-3) var(--s-4);
    }
    .tpr-more :global(.btn) {
      width: 100%;
    }
  }
</style>
