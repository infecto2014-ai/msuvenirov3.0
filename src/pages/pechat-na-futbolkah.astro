---
// «Печать на футболках» in the 3.0 design: first screen → calculator (T-shirts only) → ready-made variants →
// constructor invitation (the home block) → «Подробнее о футболке» → works → reviews → questions → price table
// (open, at the very bottom). JSON-LD: breadcrumbs, service with the «от» price, FAQPage.
import BaseLayout from '@/layouts/BaseLayout.astro';
import TeeHero from '@/components/tshirt/TeeHero.astro';
import TeePresets from '@/components/tshirt/TeePresets.astro';
import TeeDetails from '@/components/tshirt/TeeDetails.astro';
import TeePrices from '@/components/tshirt/TeePrices.astro';
import ConstructorBanner from '@/components/home/ConstructorBanner.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import Button from '@/components/ui/Button.astro';
import Calculator from '@/components/islands/Calculator';
import Works from '@/components/home/Works.astro';
import Reviews from '@/components/home/Reviews.astro';
import Faq from '@/components/home/Faq.astro';
import { site } from '@/data/site';
import { findProduct } from '@/data/pricing';
import { teeFaq, teeReviews, teeWorks } from '@/data/tshirt';
import { breadcrumbs, faqPage, service } from '@/lib/schema';

const description =
  'Печать на белых, чёрных и цветных футболках в ТЦ «Экватор»: DTF-печать от А6 до А3, взрослые и детские размеры, от 1 штуки. Рассчитайте цену онлайн и оставьте заявку.';
const lowPrice = Math.min(...['tshirt-unisex', 'tshirt-kids'].map((id) => findProduct('textile', id)!.fromPrice));
const schema = [
  breadcrumbs([
    { name: 'Главная', href: '/' },
    { name: 'Печать на одежде', href: '/pechat-na-odezhde' },
    { name: 'Футболки', href: '/pechat-na-futbolkah' },
  ]),
  service({ name: 'Печать на футболках', description, url: '/pechat-na-futbolkah', lowPrice }),
  faqPage(teeFaq),
];
---

<BaseLayout
  title="Печать на футболках в Калининграде — от 1 штуки | Мастерская сувениров"
  description={description}
  path="/pechat-na-futbolkah"
  schema={schema}
>
  <TeeHero />

  <section class="section tee-calc-sec" aria-labelledby="tee-calc-title">
    <div class="wrap">
      <SectionHead id="tee-calc-title" title="Рассчитайте" accent="стоимость" lead="Выберите футболку, цвет и принты — цена за штуку и за тираж посчитается сразу." />
      <div class="tee-calc">
        <Calculator client:visible category="textile" products={['tshirt-unisex', 'tshirt-kids']} hideCategories />
      </div>
      <noscript>
        <style>
          .tee-calc {
            display: none;
          }
        </style>
        <div class="tee-nojs">
          <p>
            Калькулятор работает при включённом JavaScript. Позвоните или напишите нам — посчитаем стоимость за пару минут.
          </p>
          <div class="tee-nojs-actions">
            <Button href={site.phoneHref} icon="phone">{site.phone}</Button>
            <Button href={site.social.telegram} variant="ghost" icon="send" target="_blank" rel="noopener">Написать в Telegram</Button>
          </div>
        </div>
      </noscript>
    </div>
  </section>

  <div class="band-sky"><TeePresets /></div>
  <div class="tee-cb"><ConstructorBanner /></div>
  <TeeDetails />
  <div class="band-sky">
    <Works works={teeWorks} title="Наши работы" accent="на футболках" lead="Настоящие футболки наших клиентов" />
  </div>
  <Reviews items={teeReviews} title="Отзывы" accent="о печати на футболках" />
  <div class="band-sky">
    <Faq items={teeFaq} title="Вопросы" accent="о футболках" />
  </div>
  <TeePrices />
</BaseLayout>

<style>
  .band-sky {
    background: var(--sky-2);
  }
  .tee-calc-sec {
    padding-top: var(--s-7);
  }
  /* the home banner sits right under a section there; here it follows the light-blue band */
  .tee-cb :global(.cb-sec) {
    padding-top: var(--s-8);
  }
  .tee-nojs {
    padding: var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--white);
    box-shadow: var(--shadow-card);
  }
  .tee-nojs p {
    max-width: 40rem;
    font-size: var(--fs-lg);
  }
  .tee-nojs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-5);
  }
  @media (max-width: 900px) {
    .tee-cb :global(.cb-sec) {
      padding-top: var(--s-7);
    }
  }
  @media (max-width: 560px) {
    .tee-nojs {
      padding: var(--s-5) var(--s-4);
    }
    .tee-nojs-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
