---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CorporateHero from '@/components/corporate/CorporateHero.astro';
import CorporateDirections from '@/components/corporate/CorporateDirections.astro';
import Clients from '@/components/home/Clients.astro';
import Contacts from '@/components/home/Contacts.astro';
import Faq from '@/components/home/Faq.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { corporate as page } from '@/data/corporate';
import { site } from '@/data/site';
import { BUSINESS_ID, breadcrumbs, faqPage } from '@/lib/schema';
const slug = '/korporativnym-klientam';
const schema = [breadcrumbs([{name:'Главная',href:'/'},{name:'Для компаний',href:slug}]),faqPage(page.faq),{
 '@context':'https://schema.org','@type':'Service',name:page.h1,description:page.description,serviceType:'Брендирование продукции для компаний',url:`${site.url}${slug}`,areaServed:{'@type':'City',name:site.address.city},provider:{'@id':BUSINESS_ID},hasOfferCatalog:{'@type':'OfferCatalog',name:'Направления брендирования',itemListElement:page.directions.map(d=>({'@type':'OfferCatalog',name:d.title,description:d.lead}))},
}];
---
<BaseLayout title={page.title} description={page.description} path={slug} schema={schema}>
 <CorporateHero/>
 <Clients/>
 <div class="company-solutions-band"><CorporateDirections/></div>
 <section class="section company-cases" aria-labelledby="company-cases-title"><div class="wrap">
  <SectionHead id="company-cases-title" eyebrow="Работы мастерской" title="Уже" accent="в деле" lead="Форма, мерч и подарки из нашего портфолио."/>
  <ul class="case-grid" role="list">{page.cases.map(c=><li class="case-card"><figure><img src={c.image} width="480" height="360" alt={c.title} loading="lazy" decoding="async"/></figure><div class="case-copy"><h3>{c.title}</h3><p>{c.text}</p><ul class="case-tags" role="list">{c.tags.map(t=><li>{t}</li>)}</ul></div></li>)}</ul>
 </div></section>
 <section class="section company-process" aria-labelledby="company-process-title"><div class="wrap">
  <SectionHead id="company-process-title" title="От заявки" accent="до тиража" lead="До запуска согласуем макет, образец и срок изготовления."/>
  <ol class="process-grid" role="list">{page.process.map((p,i)=><li><span class="process-number" aria-hidden="true">0{i+1}</span><div><h3>{p.title}</h3><p>{p.text}</p></div></li>)}</ol>
 </div></section>
 <section class="section company-terms" aria-labelledby="company-terms-title"><div class="wrap terms-layout">
  <div class="terms-intro"><p>Условия для организаций</p><h2 id="company-terms-title">Тираж — для команды.<br/><span>Документы — для бухгалтерии.</span></h2><p>Договор, оплата и выдача заказа: основные условия собраны здесь.</p><Button data-order="Запрос КП для компании" icon="file-text">Запросить КП</Button></div>
  <ul class="term-list" role="list">{page.terms.map(t=><li><Icon name="check" size={20}/><div><h3>{t.title}</h3><p>{t.text}</p></div></li>)}</ul>
 </div></section>
 <section class="section company-more" aria-label="Подробная информация для компаний"><div class="wrap">
  <details class="company-seo"><summary><span>О брендировании для компаний<small>Производство, подбор изделий и подготовка макета</small></span><Icon name="chevron-down" size={22}/></summary><div class="seo-grid"><h2>{page.seo.title}</h2>{page.seo.sections.map(s=><article><h3>{s.title}</h3>{s.paragraphs.map(p=><p>{p}</p>)}</article>)}</div></details>
  <details class="company-faq"><summary><span>Вопросы компаний · {page.faq.length}<small>Тиражи, фирменные цвета, образцы и оплата</small></span><Icon name="chevron-down" size={22}/></summary><Faq items={page.faq} title="Вопросы" accent="компаний"/></details>
 </div></section>
 <section class="section company-request" aria-labelledby="company-request-title"><div class="wrap request-panel"><div><p class="request-eyebrow">Ваш следующий тираж начинается здесь</p><h2 id="company-request-title">Соберём предложение<br/>под вашу задачу</h2><p>Расскажите, что нужно, в каком количестве и к какой дате. Если есть логотип или брендбук — приложите к заявке.</p><div class="request-actions"><Button data-order="Запрос КП для компании" icon="file-text">Запросить КП</Button><Button href={site.social.telegram} variant="ghost" icon="send" target="_blank" rel="noopener noreferrer">Telegram<span class="visually-hidden"> (новая вкладка)</span></Button></div></div><ul class="request-list" role="list"><li><span>01</span>Изделия и задача</li><li><span>02</span>Примерный тираж</li><li><span>03</span>Дата готовности</li><li><span>04</span>Логотип и пожелания</li></ul></div></section>
 <Contacts/>
</BaseLayout>
<style>
 .company-seo>summary:focus-visible,.company-faq>summary:focus-visible{outline:3px solid var(--focus);outline-offset:-5px;border-radius:var(--radius-card);}
 .company-terms{--focus:var(--white);}
 .company-solutions-band{background:var(--sky-2);}.case-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--s-4);}.case-card{min-width:0;border:1px solid var(--line);border-radius:var(--radius-card);overflow:hidden;background:var(--white);}.case-card figure{aspect-ratio:4/3;background:var(--sky-2);}.case-card img{width:100%;height:100%;object-fit:contain;}.case-copy{padding:var(--s-5);}.case-copy h3{font-size:var(--fs-lg);}.case-copy p{font-size:var(--fs-sm);color:var(--muted);margin-top:var(--s-3);}.case-tags{display:flex;flex-wrap:wrap;gap:var(--s-2);margin-top:var(--s-4);}.case-tags li{font-size:var(--fs-xs);border:1px solid var(--line);border-radius:var(--radius-pill);padding:4px 10px;color:var(--muted);}
 .company-process{background:var(--sky-2);}.process-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s-5);}.process-grid li{display:flex;align-items:flex-start;gap:var(--s-4);padding:var(--s-5);border:1px solid var(--line);border-radius:var(--radius-card);background:var(--white);}.process-number{display:grid;place-items:center;flex:none;width:40px;height:40px;border-radius:50%;background:var(--sky);color:var(--blue);font-weight:800;}.process-grid h3{font-size:var(--fs-base);}.process-grid p{font-size:var(--fs-sm);color:var(--muted);margin-top:var(--s-2);}
 .company-terms{background:var(--ink);color:var(--white);}.terms-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:var(--s-7);align-items:start;}.terms-intro>p:first-child{font-size:var(--fs-sm);margin-bottom:var(--s-4);}.terms-intro h2{font-size:var(--fs-h2);line-height:1.2;letter-spacing:-.03em;}.terms-intro h2 span{display:block;margin-top:var(--s-2);}.terms-intro>p{margin-top:var(--s-5);}.terms-intro :global(.btn){margin-top:var(--s-5);}.term-list{display:grid;gap:var(--s-5);}.term-list li{display:flex;align-items:flex-start;gap:var(--s-3);padding-bottom:var(--s-5);border-bottom:1px solid rgba(255,255,255,.2);}.term-list li:last-child{border:0;padding-bottom:0;}.term-list :global(svg){flex:none;margin-top:2px;}.term-list h3{font-size:var(--fs-lg);}.term-list p{font-size:var(--fs-sm);margin-top:var(--s-2);}
 .company-more{padding-bottom:0;}.company-seo,.company-faq{border:1px solid var(--line);border-radius:var(--radius-card);overflow:hidden;}.company-faq{margin-top:var(--s-4);}.company-more summary{display:flex;justify-content:space-between;align-items:center;gap:var(--s-4);padding:var(--s-5);cursor:pointer;list-style:none;font-size:var(--fs-lg);font-weight:700;}.company-more summary::-webkit-details-marker{display:none;}.company-more summary small{display:block;margin-top:var(--s-1);font-size:var(--fs-sm);font-weight:400;color:var(--muted);}.company-more summary>:global(svg){flex:none;}.company-more details[open]>summary>:global(svg){transform:rotate(180deg);}.seo-grid{padding:var(--s-5);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--s-5);background:var(--sky-2);}.seo-grid>h2{grid-column:1/-1;font-size:var(--fs-h3);}.seo-grid h3{font-size:var(--fs-lg);}.seo-grid p{font-size:var(--fs-sm);color:var(--muted);margin-top:var(--s-3);}.company-faq :global(.wrap){width:100%;}.company-faq :global(.faq-sec){padding:var(--s-5);}
 .request-panel{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:var(--s-7);align-items:center;border:1px solid var(--line);border-radius:var(--radius-panel);padding:var(--s-7);background:var(--sky);}.request-eyebrow{font-size:var(--fs-sm);color:var(--muted);margin-bottom:var(--s-4);}.request-panel h2{font-size:var(--fs-h2);line-height:1.15;letter-spacing:-.03em;}.request-panel h2+p{max-width:580px;color:var(--muted);margin-top:var(--s-4);}.request-actions{display:flex;flex-wrap:wrap;gap:var(--s-3);margin-top:var(--s-5);}.request-list{display:grid;gap:var(--s-4);}.request-list li{display:flex;align-items:center;gap:var(--s-4);font-weight:600;}.request-list span{display:grid;place-items:center;flex:none;width:40px;height:40px;border-radius:50%;background:var(--white);color:var(--blue);font-weight:800;}
 @media(max-width:1100px){.case-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.process-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.terms-layout{grid-template-columns:minmax(0,1fr);gap:var(--s-6);}.terms-intro{max-width:760px;}.request-panel{grid-template-columns:minmax(0,1fr);gap:var(--s-6);}.request-list{grid-template-columns:repeat(2,minmax(0,1fr));}}
 @media(max-width:560px){.case-grid,.process-grid,.seo-grid{grid-template-columns:minmax(0,1fr);}.case-copy,.process-grid li{padding:var(--s-4);}.request-panel{padding:var(--s-5);}.request-actions{display:grid;grid-template-columns:minmax(0,1fr);}.request-list{grid-template-columns:minmax(0,1fr);}.company-more summary{padding:var(--s-4);font-size:var(--fs-base);}.company-more summary small{font-size:var(--fs-xs);}.company-faq :global(.faq-sec){padding:var(--s-4);}.process-grid li{gap:var(--s-3);}.terms-intro h2{font-size:clamp(1.7rem,7vw,2.3rem);}}
</style>
