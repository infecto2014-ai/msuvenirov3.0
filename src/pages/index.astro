import MerchHero from '@/components/home-concept/MerchHero.astro';
import PrintSeries from '@/components/home-concept/PrintSeries.astro';
import '@/styles/merch-home.css';
---

<BaseLayout
  title="Печать на одежде и сувенирах в Калининграде — Мастерская сувениров"
  description="Ваш дизайн на одежде, кружках и шопперах. Мастерская печати в Калининграде, ТЦ «Экватор». Обсудим идею и поможем с заказом."
  path="/"
  homeConcept
>
  <ConceptHeader slot="header" />
  <MerchHero />
  <PrintSeries />
</BaseLayout>
