import Facts from '@/components/home/Facts.astro';
import Catalog from '@/components/home/Catalog.astro';
import ConstructorBanner from '@/components/home/ConstructorBanner.astro';
---

<BaseLayout
  title="Печать на футболках, кружках и сувенирах в Калининграде — Мастерская сувениров"
  description="Мастерская печати в ТЦ «Экватор»: футболки, кружки, значки, стикеры, полиграфия с вашим дизайном — от 1 штуки. Рассчитайте цену и оставьте заявку."
  path="/"
>
  <Hero />
  <Facts />
  <Catalog />
  <ConstructorBanner />
</BaseLayout>
